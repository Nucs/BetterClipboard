<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for the platform-neutral core (classification, codecs, SQLite store, pipeline, settings). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xunit v3 test projects are executables (they host their own runner). -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>BetterClipboard.Core.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Runs on Microsoft.Testing.Platform (opted in via global.json); no VSTest adapter needed. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BetterClipboard.Core\BetterClipboard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
