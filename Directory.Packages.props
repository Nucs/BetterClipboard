<Project>
  <!-- Central package management: every PackageReference in the repo takes its version from here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- UI stack -->
    <!--
      Windows App SDK components instead of the Microsoft.WindowsAppSDK 2.5.1 metapackage: the metapackage
      also drags in AI (Phi Silica / semantic index), ML (onnxruntime + DirectML, ~40 MB), Search and
      Widgets, none of which BetterClipboard uses. Versions are the ones metapackage 2.5.1 pins; bump them
      together from its dependency list (`nuget deps Microsoft.WindowsAppSDK <version>`).
    -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!--
      Storage: Microsoft.Data.Sqlite.Core (no bundled engine) + SQLite3 Multiple Ciphers as the engine,
      which encrypts the whole database (pages, WAL, FTS index) with ChaCha20-Poly1305. SQLite3MC 2.4
      is built on SQLitePCLRaw 3.x while MDS 10 was compiled against 2.1 — verified compatible
      (encryption, FTS5 trigram, WAL, rekey) by the storage tests; re-verify when bumping either.
    -->
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.12" />
    <PackageVersion Include="SQLite3MC.PCLRaw.bundle" Version="2.4.0" />

    <!-- DPAPI (CryptProtectData) for sealing the database key to the Windows account. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />

    <!-- Tests (Microsoft.Testing.Platform runner, see global.json) -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
</Project>
