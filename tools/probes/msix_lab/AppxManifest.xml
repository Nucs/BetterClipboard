<?xml version="1.0" encoding="utf-8"?>
<!--
  msix_lab's package manifest: a full-trust (medium integrity) desktop package with a console alias and a startup task,
  the same shape as BetterClipboard's Microsoft Store package. Registered loose (Add-AppxPackage -Register) inside a
  claude-desktops Windows desktop by run-lab.ps1; never on a PC in use. The Resources list is rewritten by run-lab.ps1
  for the language test.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop desktop4 rescap">
  <Identity Name="BCTest.MsixLab" Publisher="CN=BC-TEST" Version="1.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>BC-TEST msix lab</DisplayName>
    <PublisherDisplayName>BC-TEST</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application Id="Lab" Executable="msixlab.exe" EntryPoint="Windows.FullTrustApplication" desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements DisplayName="BC-TEST msix lab" Description="BetterClipboard packaging probe" BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" AppListEntry="none" />
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="msixlab.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="msixlab.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
        <desktop:Extension Category="windows.startupTask" Executable="msixlab.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="MsixLabStartup" Enabled="false" DisplayName="BC-TEST msix lab" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
