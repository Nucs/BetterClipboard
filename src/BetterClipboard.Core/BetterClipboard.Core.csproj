<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Platform-neutral heart of BetterClipboard: models, content classification, SQLite persistence,
    retention, settings and the capture pipeline. Deliberately free of Win32/WinRT so it can be unit
    tested anywhere; everything OS-specific lives in BetterClipboard.Windows behind small interfaces.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BetterClipboard.Core</RootNamespace>
    <!-- Undocumented public API is a build error here: the repo rule is "fully documented or not done". -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BetterClipboard.Core.Tests" />
  </ItemGroup>

  <!--
    The interface languages, embedded in this assembly so a release is one build for every language and no copy can
    lose a language file: one catalog per language (Localization/{tag}.json, its names and flag in a "$language" header)
    and the flags those headers name (Localization/Flags/{flag}.svg, drawn by tools/make_flags.py). UiText finds every
    catalog by its resource name, so a new language needs no code. LogicalName pins the names UiText looks for, whatever
    MSBuild would derive from the folders.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="BetterClipboard.Core.Localization.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Localization\Flags\*.svg" LogicalName="BetterClipboard.Core.Localization.Flags.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
