<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The BetterClipboard desktop app: WinUI 3 (Windows App SDK 2.x), unpackaged and self-contained
    (the WinAppSDK runtime ships next to the exe, so no runtime installer is needed). The .NET 10 runtime
    itself is framework-dependent.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>BetterClipboard.App</RootNamespace>
    <AssemblyName>BetterClipboard</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\BetterClipboard.ico</ApplicationIcon>

    <!-- WinUI needs a concrete architecture; default to the build machine's x64. -->
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</PlatformTarget>
    <SelfContained>false</SelfContained>

    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Custom Main (single instance, sync context) lives in Program.cs. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the Windows App SDK components the app uses (see Directory.Packages.props). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BetterClipboard.Core\BetterClipboard.Core.csproj" />
    <ProjectReference Include="..\BetterClipboard.Windows\BetterClipboard.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The Microsoft Store edition (CLAUDE.md §2.47, docs/microsoft-store.md): the same app, built as an MSIX package.
    Nothing below applies to the unpackaged build. tools/release/package-msix.ps1 publishes with
    WindowsPackageType=MSIX and passes:
      StoreAppxManifest    the manifest it filled in from packaging/msix/Package.appxmanifest (identity, version,
                           architecture);
      StoreExtraFilesDir   a folder of files that ride along in the package root: bclip (the package declares it as a
                           second application with a console alias) and install.ps1, which that edition runs in its
                           uninstall mode to remove a copy of BetterClipboard it replaces.
    The package's logos are the files in packaging/msix/Assets (tools/make_store_assets.py draws them); they are
    linked to Assets\Store, where the manifest names them, and Windows picks by the qualifiers in their names.
  -->
  <PropertyGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <!-- The Store signs what it publishes; a test package is signed by the script after the build. -->
    <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>

    <!-- One flat package per architecture: no bundle (a bundle could never go back to flat packages), no installer file, no symbols package. -->
    <AppxBundle>Never</AppxBundle>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <StoreAssetsDir Condition="'$(StoreAssetsDir)' == ''">$(MSBuildThisFileDirectory)..\..\packaging\msix\Assets\</StoreAssetsDir>

    <!--
      The package build's obj and bin are under artifacts (Directory.Build.props), so the SDK no longer leaves this
      folder's own obj and bin out by itself: without this line the unpackaged build's generated sources there would
      be compiled into the package build a second time.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <AppxManifest Include="$(StoreAppxManifest)" />
    <Content Include="$(StoreAssetsDir)*.png" Link="Assets\Store\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(WindowsPackageType)' == 'MSIX' And '$(StoreExtraFilesDir)' != ''">
    <Content Include="$(StoreExtraFilesDir)**\*" Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
