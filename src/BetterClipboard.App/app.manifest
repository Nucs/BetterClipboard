<?xml version="1.0" encoding="utf-8"?>
<!--
  Application manifest. PerMonitorV2 DPI awareness is essential: the flyout is positioned in physical
  pixels next to the caret on whichever monitor it is, and must render crisply at every scale factor.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="BetterClipboard.app"/>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <!--
        The segment heap (Windows 10 2004+, the app's minimum) for the process heap, where WinUI, WinRT, WIC and SQLite
        allocate their native memory: it gives freed memory back to Windows, where the classic heap kept it committed after a
        burst (a Settings window, a reload of the panel's cards). UWP and Edge run on it. CLAUDE.md §2.45.
      -->
      <heapType xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings">SegmentHeap</heapType>
    </windowsSettings>
  </application>
</assembly>
