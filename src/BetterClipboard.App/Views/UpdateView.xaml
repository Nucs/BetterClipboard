<?xml version="1.0" encoding="utf-8"?>
<!--
  The update dialog's content (hosted in a flyout by UpdateDialog.cs): what is known about updates, the decision
  buttons, and below them the release notes.

  Layout: the top part (title, detail, problem, progress, buttons, "skip") is a StackPanel, because a StackPanel leaves
  no gap for a collapsed child and most of those rows are collapsed most of the time; a Grid's RowSpacing would keep
  the gaps. The notes fill the second row and are the only part that scrolls, so the buttons never move out of view.
  Their MaxHeight keeps a long changelog from making the bubble taller than it needs to be; on a small screen the star
  row gives them less.

  The Width is fixed: the release notes wrap, and a bubble that changed its width with every state would jump.

  The styles below hold the theme brushes of the release notes. The notes are built in code (MarkdownRenderer.cs), and
  a brush looked up in code would come from the app's theme; a style applied to an element resolves its ThemeResource
  setters in that element's own theme, which is the flyout's (the panel can be light while the app is dark).
-->
<UserControl
    x:Class="BetterClipboard.App.Views.UpdateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="440">
    <UserControl.Resources>
        <Style x:Key="NotesTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="NotesSecondaryTextStyle"
            BasedOn="{StaticResource NotesTextStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <!--  The line over one release's notes ("0.2.7 · 12 Oct 2026").  -->
        <Style
            x:Key="NotesReleaseHeadingStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="NotesCodeBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style x:Key="NotesQuoteBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Padding" Value="10,0,0,0" />
        </Style>
        <Style x:Key="NotesRuleStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="NotesTableCellStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,4,10,4" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="10">
            <TextBlock
                x:Name="TitleText"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="DetailText"
                Margin="0,-4,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <!--  Why the last check or the last installation failed. Not closable: it goes when the problem does.  -->
            <InfoBar
                x:Name="ProblemBar"
                IsClosable="False"
                IsOpen="False" />
            <ProgressBar
                x:Name="Progress"
                AutomationProperties.Name="Update progress"
                Maximum="100"
                Visibility="Collapsed" />

            <!--  The decision. Which buttons show, and what they say, follows the state (UpdateView.Render).  -->
            <StackPanel
                x:Name="ButtonRow"
                Orientation="Horizontal"
                Spacing="8">
                <Button x:Name="PrimaryButton" Click="PrimaryButton_Click" />
                <Button x:Name="SecondaryButton" Click="SecondaryButton_Click" />
                <Button x:Name="TertiaryButton" Click="TertiaryButton_Click" />
            </StackPanel>
            <!--  Negative margins: the link's text lines up with the buttons' left edge, its hover fill reaches past it.  -->
            <HyperlinkButton
                x:Name="SkipLink"
                Margin="-6,-6,0,-4"
                Padding="6,3,6,3"
                Click="SkipLink_Click"
                Visibility="Collapsed" />

            <!--  Below the buttons: the release notes, under a divider.  -->
            <Grid
                Margin="0,2,0,0"
                Padding="0,10,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <TextBlock
                    x:Name="NotesHeading"
                    VerticalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <!--  E8A7 = OpenInNewWindow: the link leaves the app for the browser.  -->
                <HyperlinkButton
                    x:Name="ReleasePageLink"
                    Margin="0,-4,-6,-4"
                    Padding="6,3,6,3"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="View the release on GitHub"
                    Click="ReleasePageLink_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="View on GitHub" />
                        <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                    </StackPanel>
                </HyperlinkButton>
            </Grid>
        </StackPanel>

        <!--  Right padding: room for the scroll bar, so it never covers the last letters of a line.  -->
        <ScrollViewer
            x:Name="NotesScroller"
            Grid.Row="1"
            MaxHeight="380"
            Margin="0,8,-8,0"
            Padding="0,0,14,0"
            VerticalAlignment="Top"
            AutomationProperties.Name="Release notes"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="NotesPanel" Spacing="6" />
        </ScrollViewer>
    </Grid>
</UserControl>
