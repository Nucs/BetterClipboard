<?xml version="1.0" encoding="utf-8"?>
<!--
  The content of the Microsoft Store edition's setup window (CLAUDE.md §2.47): a heading and a lead, then either the
  lines of a check or a move (one per row: a sign for its state, what it is, what was found) or the welcome's two
  switches, an error bar, a progress bar, and the buttons. Every text comes from StoreSetupViewModel, which
  AppController.Store.cs fills page by page; the view decides nothing.

  A UserControl on purpose, with the window made in code (StoreSetupWindow.cs): compiled bindings of a UserControl
  hook nothing on the window, so the closed window is not kept in memory (CLAUDE.md §2.45).

  Glyphs (checked by rendering): E73E = CheckMark, E7BA = Warning, E711 = Cancel.
-->
<UserControl
    x:Class="BetterClipboard.App.Views.StoreSetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BetterClipboard.App.ViewModels">

    <Grid
        x:Name="Root"
        Padding="28,22,28,20"
        RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Heading: the app's icon and the page's title.  -->
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Width="36"
                Height="36"
                VerticalAlignment="Top"
                Source="ms-appx:///Assets/AppIcon64.png" />
            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                TextWrapping="Wrap" />
        </Grid>

        <TextBlock
            Grid.Row="1"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            IsTextSelectionEnabled="True"
            Text="{x:Bind ViewModel.Lead, Mode=OneWay}"
            TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">

                <!--  The welcome page: good news from a move (if any), the two switches, and what is kept.  -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsWelcome, Mode=OneWay}">
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasWelcomeNote, Mode=OneWay}"
                        Message="{x:Bind ViewModel.WelcomeNote, Mode=OneWay}"
                        Severity="Success" />

                    <Grid
                        Padding="16,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ColumnSpacing="16"
                        CornerRadius="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Name="WinVTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="WinVDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="WinVSwitch"
                            Grid.Column="1"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind ViewModel.UseWinV, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>

                    <Grid
                        Padding="16,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ColumnSpacing="16"
                        CornerRadius="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Name="StartupTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.StartupDescription, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="StartupSwitch"
                            Grid.Column="1"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind ViewModel.CanChangeStartup, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>

                    <TextBlock
                        x:Name="KeptNote"
                        Margin="2,4,2,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        x:Name="PrivacyLink"
                        Margin="-10,-4,0,0"
                        Click="PrivacyLink_Click" />
                </StackPanel>

                <!--  A check's or a move's lines.  -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SetupRowViewModel">
                            <Grid
                                Margin="0,0,0,6"
                                Padding="14,10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ColumnSpacing="12"
                                CornerRadius="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  One of five signs, by the line's state.  -->
                                <Grid
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Top">
                                    <Ellipse
                                        Width="10"
                                        Height="10"
                                        Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                                        StrokeThickness="1.5"
                                        Visibility="{x:Bind IsPending, Mode=OneWay}" />
                                    <ProgressRing
                                        Width="16"
                                        Height="16"
                                        IsActive="{x:Bind IsRunning, Mode=OneWay}"
                                        Visibility="{x:Bind IsRunning, Mode=OneWay}" />
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Glyph="&#xE73E;"
                                        Visibility="{x:Bind IsOk, Mode=OneWay}" />
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Glyph="&#xE7BA;"
                                        Visibility="{x:Bind IsWarning, Mode=OneWay}" />
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Glyph="&#xE711;"
                                        Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                                </Grid>

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Detail, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind HasDetail, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <InfoBar
            Grid.Row="3"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
            Severity="Error" />

        <ProgressBar
            Grid.Row="4"
            IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
            Maximum="100"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />

        <!--  Footer: the way out on the left, a quiet note, then the page's one or two buttons.  -->
        <Grid Grid.Row="5" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <HyperlinkButton
                x:Name="QuitButton"
                Margin="-10,0,0,0"
                VerticalAlignment="Center"
                Click="QuitButton_Click"
                Content="{x:Bind ViewModel.QuitText, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.FooterNote, Mode=OneWay}"
                TextAlignment="Right"
                TextWrapping="Wrap" />
            <Button
                x:Name="SecondaryButton"
                Grid.Column="2"
                MinWidth="110"
                Click="SecondaryButton_Click"
                Content="{x:Bind ViewModel.SecondaryText, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasSecondary, Mode=OneWay}" />
            <Button
                x:Name="PrimaryButton"
                Grid.Column="3"
                MinWidth="130"
                Click="PrimaryButton_Click"
                Content="{x:Bind ViewModel.PrimaryText, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.IsPrimaryEnabled, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>
