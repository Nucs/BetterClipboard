                                Click="AddCommandLineToPath_Click"
                                Content="{loc:Tr Text='Add bclip to PATH'}"
                                IsEnabled="{x:Bind ViewModel.CanAddCommandLineToPath, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsNotStoreEdition}" />
                        </StackPanel>
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{x:Bind ViewModel.DataFolder}"
                    Glyph="&#xE8B7;"
                    Header="{loc:Tr Text='Data folder'}"
                    Keywords="{loc:Tr Text='storage location, files, backup, path'}">
                    <Button Click="OpenDataFolder_Click" Content="{loc:Tr Text='Open'}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{x:Bind ViewModel.VersionText}"
                    Glyph="&#xE946;"
                    Header="{loc:Tr Text='About BetterClipboard'}"
                    Keywords="{loc:Tr Text='version, exit, quit, close'}">
                    <Button Click="Exit_Click" Content="{loc:Tr Text='Exit BetterClipboard'}" />
                </controls:SettingsCard>

                <!--
                  Updates (ViewModel: SettingsViewModel.Updates.cs). The switch is the one thing in BetterClipboard that
                  decides whether it contacts a server by itself, so the card says exactly what is asked and what is not
                  sent. "Check now" asks once whatever the switch says. The second button opens the same update dialog as
                  the panel's update button (the decision buttons, and below them the release notes); it is the accent
                  button while an update waits. E895 = Sync, the update button's glyph (checked by rendering).
                -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{loc:Tr Text='Updates'}" />
                <controls:SettingsCard
                    x:Name="UpdatesCard"
                    Description="{loc:Tr Text=&quot;Once a day, BetterClipboard asks GitHub for the list of its releases and highlights the update button in the panel when a newer version exists. The request names only the app's version: nothing about you, your PC or your clipboard is sent. Nothing is downloaded or installed until you approve it. Off: it asks only when you press Check now.&quot;}"
                    Glyph="&#xE895;"
                    Header="{loc:Tr Text='Check for updates automatically'}"
                    Keywords="{loc:Tr Text='upgrade, new version, GitHub, releases'}">
                    <ToggleSwitch OnContent="{loc:Tr Text='On'}" OffContent="{loc:Tr Text='Off'}" IsEnabled="{x:Bind ViewModel.CanToggleUpdateCheck, Mode=OneWay}" IsOn="{x:Bind ViewModel.CheckForUpdates, Mode=TwoWay}" />
                    <controls:SettingsCard.Footer>
                        <StackPanel Spacing="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Click="CheckForUpdates_Click"
                                    Content="{loc:Tr Text='Check now'}"
                                    IsEnabled="{x:Bind ViewModel.CanCheckForUpdates, Mode=OneWay}" />
                                <!--  Its flyout (the update dialog) and its accent style while an update waits are set in code-behind.  -->
                                <Button
                                    x:Name="UpdateDialogButton"
                                    Content="{x:Bind ViewModel.UpdateActionText, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.HasUpdateSystem, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>

                <!--
                  The Microsoft Store edition's Updates card (CLAUDE.md §2.47): the Store updates that edition, and the app
                  itself asks no server. SettingsWindow.Store.cs keeps this card in the Store edition and the card above
                  in every other one, by taking the other out of the page (the search would otherwise show both).
                -->
                <controls:SettingsCard
                    x:Name="StoreUpdatesCard"
                    Description="{loc:Tr Text='This copy comes from the Microsoft Store, which updates it by itself. BetterClipboard asks no server about updates, and Windows starts it again after an update.'}"
                    Glyph="&#xE895;"
                    Header="{loc:Tr Text='Updates from the Microsoft Store'}"
                    Keywords="{loc:Tr Text='upgrade, new version, Microsoft Store, release notes'}">
                    <Button Click="OpenStorePage_Click" Content="{loc:Tr Text='Open in Microsoft Store'}" />
                </controls:SettingsCard>

                <!--
                  Third party: the apps BetterClipboard works with and the components it ships, each with its official
                  link. The rows come from Core's ThirdPartyCatalog, whose tests keep it in step with
                  THIRD-PARTY-NOTICES.md and with the packages the app restores (CLAUDE.md, "Third party" section).
                  EA86 = Puzzle, E8F1 = Library (both checked by rendering).
                -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{loc:Tr Text='Third party'}" />
                <controls:SettingsCard
                    Description="{loc:Tr Text='Apps by other makers that BetterClipboard reads from while their setting above is on. BetterClipboard is not affiliated with them; get them from their official sites.'}"
                    Glyph="&#xEA86;"
                    Header="{loc:Tr Text='Works with'}"
                    Keywords="{loc:Tr Text='integrations, other apps, credits, links'}">
                    <controls:SettingsCard.Footer>
                        <ItemsControl
                            AutomationProperties.Name="{loc:Tr Text='Apps BetterClipboard works with'}"
                            IsTabStop="False"
                            ItemTemplate="{StaticResource ThirdPartyRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.WorksWith}" />
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Text='The components inside BetterClipboard, each under its own license.'}"
                    Glyph="&#xE8F1;"
                    Header="{loc:Tr Text='Built with'}"
                    Keywords="{loc:Tr Text='licenses, open source, components, libraries, notices'}">
                    <HyperlinkButton
                        AutomationProperties.Name="{loc:Tr Text='License notices'}"
                        NavigateUri="{x:Bind ViewModel.NoticesLink}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.NoticesLink.AbsoluteUri}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{loc:Tr Text='License notices'}" />
                            <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                        </StackPanel>
                    </HyperlinkButton>
                    <controls:SettingsCard.Footer>
                        <ItemsControl
                            AutomationProperties.Name="{loc:Tr Text='Components inside BetterClipboard'}"
                            IsTabStop="False"
                            ItemTemplate="{StaticResource ThirdPartyRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.BuiltWith}" />
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
