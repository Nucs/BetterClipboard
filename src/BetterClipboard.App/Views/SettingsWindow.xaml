<?xml version="1.0" encoding="utf-8"?>
<!--
  Main/settings window (Mica, custom title bar). Sections mirror the Windows 11 Settings app so it
  feels native: Shortcut, History, Pasting, Privacy, Windows clipboard, Integrations, App, and Third
  party (credits and official links) at the bottom.
-->
<Window
    x:Class="BetterClipboard.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:BetterClipboard.App.Localization"
    xmlns:controls="using:BetterClipboard.App.Controls"
    xmlns:vm="using:BetterClipboard.App.ViewModels"
    xmlns:views="using:BetterClipboard.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
        <!--  Ctrl+F (and Ctrl+E, the browsers' other key) go to the search box from anywhere in the window.  -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="F"
                Invoked="FocusSearch_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="E"
                Invoked="FocusSearch_Invoked"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <!--
              One project in Third party (both cards): name + credit, what it is for, and its official link. The top
              border divides the rows; on the first row it separates the list from the card's header. The link opens
              in the browser through NavigateUri; its accessible name says which project it belongs to, since bare
              sites repeat (learn.microsoft.com twice), and the tooltip shows the whole address.
            -->
            <DataTemplate x:Key="ThirdPartyRowTemplate" x:DataType="vm:ThirdPartyItemViewModel">
                <Grid
                    Padding="0,8,0,8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <!--  The runs stay on one line: whitespace between them would become text.  -->
                        <TextBlock TextWrapping="Wrap"><Run Text="{x:Bind Name}" /><Run FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind CreditRun}" /></TextBlock>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Use}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <HyperlinkButton
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind LinkName}"
                        NavigateUri="{x:Bind Link}"
                        ToolTipService.ToolTip="{x:Bind LinkTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind LinkText}" />
                            <!--  E8A7 = OpenInNewWindow: the link leaves the app for the browser.  -->
                            <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                        </StackPanel>
                    </HyperlinkButton>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <!--
          No title bar of our own: Windows draws it (icon, title, buttons), in the app's theme (SettingsWindow.ApplyCaptionTheme).
          An extended title bar (ExtendsContentIntoTitleBar, either WinUI API) leaked about 30 GDI handles at every open and
          close of this window, measured 2026-11-12; the owner chose Windows' own title bar (CLAUDE.md §2.45).
        -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
          The search (CLAUDE.md §2.43; SettingsWindow.Search.cs): pinned above the page, so it stays while the results scroll,
          and as wide as the page's column. While it holds text the page shows only the settings that match, highlighted; the
          count beside it is a polite live region for screen readers. No suggestion list: the page itself is the result.
        -->
        <Grid
            MaxWidth="880"
            Padding="32,10,32,10"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="SearchBox"
                AutomationProperties.Name="{loc:Tr Text='Search settings'}"
                Loaded="SearchBox_Loaded"
                PlaceholderText="{loc:Tr Text='Search settings'}"
                PreviewKeyDown="SearchBox_PreviewKeyDown"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged" />
            <TextBlock
                x:Name="SearchCount"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <ScrollViewer
            x:Name="Scroller"
            Grid.Row="1"
            Padding="0,0,0,24"
            IsTabStop="True"
            SizeChanged="Scroller_SizeChanged">
            <!--
              The page. Its children are what the search reads (SettingsWindow.Search.cs): the hero, section titles (the only
              TextBlock children) and settings cards, each card belonging to the title before it.
            -->
            <StackPanel
                x:Name="SettingsPage"
                MaxWidth="880"
                Padding="32,8,32,24"
                HorizontalAlignment="Stretch">

                <!--  Hero (hidden while a search shows)  -->
                <Grid
                    x:Name="Hero"
                    Margin="0,8,0,4"
                    ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Width="72"
                        Height="72"
                        VerticalAlignment="Top"
                        Source="ms-appx:///Assets/AppIcon.png" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="BetterClipboard" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{loc:Tr Text='Everything you copy — kept, searchable and pinned. Even after a restart.'}"
                            TextWrapping="Wrap" />
                        <StackPanel
                            Margin="0,6,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Border Style="{StaticResource ChipBorderStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        Fill="{x:Bind CaptureDotBrush(ViewModel.IsCapturePaused), Mode=OneWay}" />
                                    <TextBlock FontSize="12" Text="{x:Bind CaptureText(ViewModel.IsCapturePaused), Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ChipBorderStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE765;" />
                                    <TextBlock FontSize="12" Text="{x:Bind ViewModel.HotkeysSummary, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ChipBorderStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE81C;" />
                                    <TextBlock FontSize="12" Text="{x:Bind ViewModel.StatsText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!--  What the page says while a search finds nothing (a StackPanel: the page's TextBlocks are section titles).  -->
                <StackPanel
                    x:Name="NoMatches"
                    Margin="4,24,0,0"
                    Spacing="4"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="NoMatchesText"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{loc:Tr Text='Try another word or fewer letters. Esc clears the search.'}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Shortcut  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{loc:Tr Text='Shortcut'}" />
                <controls:SettingsCard
                    Description="{x:Bind ViewModel.HotkeyStatus, Mode=OneWay}"
                    Glyph="&#xE765;"
                    Header="{loc:Tr Text='Open BetterClipboard'}"
                    Keywords="{loc:Tr Text='hotkey, keyboard shortcut, key, Win+V, open the panel'}">
                    <StackPanel Spacing="4">
                        <!--
                          The box adds a shortcut to the list below: Enter or the Add button (HotkeyBox_KeyDown,
                          AddHotkey_Click), never focus loss, so a half-typed shortcut never becomes a global hotkey.
                          While it has focus in the active window it also records: any key pressed with Ctrl, Alt or
                          Win (or a key that works alone, such as F9 or a media key) is written into it by the
                          recorder's keyboard hook (HotkeyBox_GotFocus/LostFocus, Windows.Input.HotkeyRecorder), even
                          when Explorer or BetterClipboard itself owns that shortcut; plain typing still types.
                          A TextBox + presets menu, not an editable ComboBox: an editable ComboBox fills its inner
                          text box from SelectedItem when its template loads, so a bound Text value showed up blank.
                        -->
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="HotkeyBox"
                                MinWidth="190"
                                AutomationProperties.HelpText="{loc:Tr Text='Press the keys of the shortcut, or type its name, then press Enter.'}"
                                AutomationProperties.Name="{loc:Tr Text='Add a shortcut that opens BetterClipboard'}"
                                GotFocus="HotkeyBox_GotFocus"
                                IsSpellCheckEnabled="False"
                                IsTextPredictionEnabled="False"
                                KeyDown="HotkeyBox_KeyDown"
                                LostFocus="HotkeyBox_LostFocus"
                                PlaceholderText="{loc:Tr Text='Press a shortcut, or type one'}"
                                Text="{x:Bind ViewModel.NewHotkeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="{loc:Tr Text='Add shortcut'}"
                                Click="AddHotkey_Click"
                                Content="{loc:Tr Text='Add'}" />
                            <!--
                              Presets, then "Used before" (AppSettings.HotkeyHistory), rebuilt each time the menu opens.
                              Both are toggles: a checked one is in the list, and picking it again removes it.
                            -->
                            <DropDownButton
                                Grid.Column="2"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="{loc:Tr Text='Suggested shortcuts and shortcuts used before'}"
                                ToolTipService.ToolTip="{loc:Tr Text='Suggested shortcuts, and the ones you used before'}">
                                <DropDownButton.Flyout>
                                    <MenuFlyout
                                        x:Name="HotkeyPresetsMenu"
                                        Opening="HotkeyPresetsMenu_Opening"
                                        Placement="BottomEdgeAlignedRight" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </Grid>
                        <TextBlock
                            MaxWidth="300"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.HotkeyError, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind HasText(ViewModel.HotkeyError), Mode=OneWay}" />
                        <TextBlock
                            MaxWidth="300"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.HotkeyHint, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind HasText(ViewModel.HotkeyHint), Mode=OneWay}" />
                    </StackPanel>
                    <controls:SettingsCard.Footer>
                        <!--  One row per shortcut, main one first: its state, and Remove (disabled for the only one).  -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Hotkeys}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HotkeyItemViewModel">
                                    <Grid
                                        Padding="0,6,4,6"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Text}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Status}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind WorkingVisibility}" />
                                            <TextBlock
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Status}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind ProblemVisibility}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind RemoveName}"
                                            Click="RemoveHotkey_Click"
                                            Content="{loc:Tr Text='Remove'}"
                                            IsEnabled="{x:Bind CanRemove}"
                                            Tag="{x:Bind Text}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <!--
                  Where the shortcut opens the panel (AppSettings.Placement + CenterOnMainScreen, mapped by
                  SettingsViewModel.PlacementIndex). Right under the shortcuts since 2026-11-08: under Pasting it went
                  unnoticed. Next to the text cursor, next to the mouse, centered on the main screen, centered on the
                  screen the user is typing on (FlyoutPositioner.ChooseScreen).
                -->
                <controls:SettingsCard
                    Description="{loc:Tr Text='Where the clipboard panel opens. The current screen is the one you are typing on, or the one with the mouse when you are on the desktop.'}"
                    Glyph="&#xE8A7;"
                    Header="{loc:Tr Text='Panel position'}"
                    Keywords="{loc:Tr Text='placement, location, where, caret, mouse pointer, monitor, screen, center'}">
                    <ComboBox MinWidth="180" SelectedIndex="{x:Bind ViewModel.PlacementIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{loc:Tr Text='Next to the text cursor'}" />
                        <ComboBoxItem Content="{loc:Tr Text='Next to the mouse'}" />
                        <ComboBoxItem Content="{loc:Tr Text='Center of the main screen'}" />
                        <ComboBoxItem Content="{loc:Tr Text='Center of the current screen'}" />
                    </ComboBox>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Text='Win+V belongs to Windows, and other shortcuts may belong to other apps. When on, BetterClipboard intercepts exactly your shortcuts that are taken with a keyboard hook while it runs — quit BetterClipboard and their owners get them back instantly.'}"
                    Glyph="&#xEDA7;"
                    Header="{loc:Tr Text='Take over shortcuts owned by Windows'}"
                    Keywords="{loc:Tr Text='keyboard hook, intercept, Win+V, override'}">
                    <ToggleSwitch OnContent="{loc:Tr Text='On'}" OffContent="{loc:Tr Text='Off'}" IsOn="{x:Bind ViewModel.UseKeyboardHookFallback, Mode=TwoWay}" />
                </controls:SettingsCard>
                <!--
                  Not in the Microsoft Store edition (SettingsWindow.Store.cs takes the card out of the page): a packaged
                  app's own registry writes never reach Explorer, and the Store's policies ask for supported ways to
                  change Windows' settings (CLAUDE.md §2.47).
                -->
                <controls:SettingsCard
                    x:Name="ReleaseFromExplorerCard"
                    Description="{loc:Tr Text='Advanced: tells Explorer not to register your Win+letter shortcuts (Win+V…) at all (DisabledHotkeys), so no hook is needed and they work over admin windows too. Restarts Explorer. While BetterClipboard is not running, those shortcuts then do nothing.'}"
                    Glyph="&#xEC50;"
                    Header="{loc:Tr Text='Release from Explorer'}"
                    Keywords="{loc:Tr Text='DisabledHotkeys, Windows Explorer, registry, free Win+V'}">
                    <Button
                        Click="ReleaseFromExplorer_Click"
                        Content="{x:Bind ViewModel.ExplorerReleaseButtonText, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanChangeExplorerRelease, Mode=OneWay}" />
                    <controls:SettingsCard.Footer>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.ExplorerReleaseStatus, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>

                <!--  History  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{loc:Tr Text='History'}" />
                <controls:SettingsCard
                    Description="{loc:Tr Text='The oldest items are removed beyond this count; pinned items and items in groups are kept and not counted. 0 = unlimited. (Win+V keeps 25.)'}"
                    Glyph="&#xE81C;"
                    Header="{loc:Tr Text='Maximum items'}"
                    Keywords="{loc:Tr Text='limit, count, retention, how many'}">
                    <NumberBox
                        MinWidth="140"
                        LargeChange="1000"
                        Maximum="1000000"
                        Minimum="0"
                        SmallChange="100"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.MaxItems, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Text='Items not used for this many days are removed, except pinned items and items in groups. 0 = keep forever.'}"
                    Glyph="&#xE917;"
                    Header="{loc:Tr Text='Keep items for (days)'}"
                    Keywords="{loc:Tr Text='age, retention, expire, delete old items'}">
                    <NumberBox
                        MinWidth="140"
                        Maximum="36500"
                        Minimum="0"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.RetentionDays, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Text='Copies larger than this are not recorded. (Win+V caps at 4 MB.)'}"
                    Glyph="&#xE7C3;"
                    Header="{loc:Tr Text='Largest item (MB)'}"
                    Keywords="{loc:Tr Text='size limit, big copies, megabytes'}">
                    <NumberBox
                        MinWidth="140"
                        Maximum="1024"
                        Minimum="1"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.MaxItemSizeMB, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Text='Total size budget for history outside pins and groups; the least recently used items go first. 0 = unlimited.'}"
                    Glyph="&#xE8B7;"
                    Header="{loc:Tr Text='History size budget (MB)'}"
                    Keywords="{loc:Tr Text='disk space, storage, quota, total size'}">
                    <NumberBox
                        MinWidth="140"
                        LargeChange="1024"
                        Maximum="1048576"
                        Minimum="0"
                        SmallChange="256"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.MaxTotalSizeMB, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Text='Screenshots and copied images, with thumbnails.'}"
                    Glyph="&#xE91B;"
                    Header="{loc:Tr Text='Record images'}"
                    Keywords="{loc:Tr Text='pictures, screenshots, bitmaps, photos'}">
                    <ToggleSwitch OnContent="{loc:Tr Text='On'}" OffContent="{loc:Tr Text='Off'}" IsOn="{x:Bind ViewModel.CaptureImages, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Text='Files copied in Explorer (their paths — not the file contents).'}"
                    Glyph="&#xE8E5;"
                    Header="{loc:Tr Text='Record copied files'}"
                    Keywords="{loc:Tr Text='file lists, Explorer, paths'}">
                    <ToggleSwitch OnContent="{loc:Tr Text='On'}" OffContent="{loc:Tr Text='Off'}" IsOn="{x:Bind ViewModel.CaptureFiles, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Text='Also keep app-specific formats (Office, IDEs, design tools) for pixel-perfect pastes. Uses much more disk space.'}"
                    Glyph="&#xE943;"
                    Header="{loc:Tr Text='Preserve app-specific formats'}"
                    Keywords="{loc:Tr Text='Office, Word, Excel, rich formats, design tools'}">
                    <ToggleSwitch OnContent="{loc:Tr Text='On'}" OffContent="{loc:Tr Text='Off'}" IsOn="{x:Bind ViewModel.PreserveAllFormats, Mode=TwoWay}" />
                </controls:SettingsCard>

                <!--  Pasting  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{loc:Tr Text='Pasting'}" />
                <controls:SettingsCard
                    Description="{loc:Tr Text='After you pick an item, paste it into the app you came from (like Win+V). Off = only copy it.'}"
                    Glyph="&#xE77F;"
                    Header="{loc:Tr Text='Paste after choosing an item'}"
                    Keywords="{loc:Tr Text='auto paste, Ctrl+V, insert'}">
                    <ToggleSwitch OnContent="{loc:Tr Text='On'}" OffContent="{loc:Tr Text='Off'}" IsOn="{x:Bind ViewModel.PasteOnSelect, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Text='Items you paste from history jump back to the top.'}"
                    Glyph="&#xE72A;"
                    Header="{loc:Tr Text='Move pasted items to the top'}"
                    Keywords="{loc:Tr Text='order, sort, recent'}">
                    <ToggleSwitch OnContent="{loc:Tr Text='On'}" OffContent="{loc:Tr Text='Off'}" IsOn="{x:Bind ViewModel.MoveToTopOnPaste, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Text='Pinned items are listed before everything else. The panel still selects your newest copy, just below them.'}"
                    Glyph="&#xE840;"
                    Header="{loc:Tr Text='Show pinned items first'}"
                    Keywords="{loc:Tr Text='pins, order, sort, top'}">
                    <ToggleSwitch OnContent="{loc:Tr Text='On'}" OffContent="{loc:Tr Text='Off'}" IsOn="{x:Bind ViewModel.PinnedOnTop, Mode=TwoWay}" />
                </controls:SettingsCard>

                <!--  Privacy  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{loc:Tr Text='Privacy'}" />
                <controls:SettingsCard
                    Description="{loc:Tr Text='Stop recording new copies until you resume. Password managers that mark their copies as private are always skipped.'}"
                    Glyph="&#xE769;"
                    Header="{loc:Tr Text='Pause capturing'}"
                    Keywords="{loc:Tr Text='stop recording, disable, incognito, private'}">
                    <ToggleSwitch OnContent="{loc:Tr Text='On'}" OffContent="{loc:Tr Text='Off'}" IsOn="{x:Bind ViewModel.IsCapturePaused, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Text='Never record copies from these apps (process names, one per line). Comes filled with known password managers and authenticator apps (1Password, Bitwarden, KeePass, KeePassXC, LastPass, Proton Pass, RoboForm and many more); delete any you do want recorded and they stay deleted. Managers that work only inside the browser cannot be told apart from the browser.'}"
                    Glyph="&#xEA18;"
                    Header="{loc:Tr Text='Ignored apps'}"
                    Keywords="{loc:Tr Text='password managers, exclude, blocklist, apps, processes'}">
                    <controls:SettingsCard.Footer>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--
                                MaxHeight + scrolling: the built-in list alone is ~65 lines. No spelling checker: every line
                                is a program's name, and the checker would underline all of them and stay loaded (§2.45).
                            -->
                            <TextBox
                                MinHeight="64"
                                MaxHeight="240"
                                AcceptsReturn="True"
                                IsSpellCheckEnabled="False"
                                IsTextPredictionEnabled="False"
                                PlaceholderText="KeePass"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                Text="{x:Bind ViewModel.IgnoredAppsText, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Spacing="8">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Click="AddKnownPasswordManagers_Click"
                                    Content="{loc:Tr Text='Add known password managers'}"
                                    ToolTipService.ToolTip="{loc:Tr Text='Puts back every known password manager and authenticator that is missing from the list, then saves it.'}" />
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Click="ApplyIgnoredApps_Click"
                                    Content="{loc:Tr Text='Apply'}" />
                            </StackPanel>
                        </Grid>
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Text=&quot;Items you forget forever (in the panel: right-click an item › Forget forever) are deleted and never recorded again, whichever app copies them. Line endings and spaces around the text don't matter; everything else has to match. Only a fingerprint of each is kept, encrypted with your history, plus its kind, length and source app so you can tell them apart here.&quot;}"
                    Glyph="&#xE733;"
                    Header="{loc:Tr Text='Forgotten forever'}"
                    Keywords="{loc:Tr Text='forget, block, never record, fingerprint'}">
                    <Button
                        Click="AllowAllForgotten_Click"
                        Content="{loc:Tr Text='Allow all again…'}"
                        IsEnabled="{x:Bind ViewModel.HasForgotten, Mode=OneWay}" />
                    <controls:SettingsCard.Footer>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ForgottenSummary, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <!--  Bounded like the ignored-apps box, so a long list scrolls instead of stretching the page.  -->
                            <ScrollViewer
                                MaxHeight="280"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{x:Bind Visible(ViewModel.HasForgotten), Mode=OneWay}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Forgotten}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ForgottenItemViewModel">
                                            <Grid Padding="0,6,4,6" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Details}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="{x:Bind AllowAgainName}"
                                                    Click="AllowAgain_Click"
                                                    Content="{loc:Tr Text='Allow again'}"
                                                    Tag="{x:Bind Id}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
