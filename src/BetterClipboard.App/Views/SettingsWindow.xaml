                    Header="{loc:Tr Text='Start with Windows'}"
                    Keywords="{loc:Tr Text='startup, autostart, boot, sign in'}">
                    <!--
                      The Microsoft Store edition starts through its startup task (CLAUDE.md §2.47). When the user turned
                      that off in Windows' own Startup apps list, only that list can turn it on again: the switch is then
                      disabled and the button opens the list.
                    -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            VerticalAlignment="Center"
                            Click="OpenStartupApps_Click"
                            Content="{loc:Tr Text='Open Startup apps'}"
                            Visibility="{x:Bind ViewModel.ShowOpenStartupApps, Mode=OneWay}" />
                        <ToggleSwitch
                            OnContent="{loc:Tr Text='On'}"
                            OffContent="{loc:Tr Text='Off'}"
                            IsEnabled="{x:Bind ViewModel.CanChangeLaunchAtStartup, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.LaunchAtStartup, Mode=TwoWay}" />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Text='Light, dark, or follow Windows.'}"
                    Glyph="&#xE771;"
                    Header="{loc:Tr Text='Theme'}"
                    Keywords="{loc:Tr Text='dark mode, light mode, colors, appearance'}">
                    <ComboBox MinWidth="180" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{loc:Tr Text='Use Windows setting'}" />
                        <ComboBoxItem Content="{loc:Tr Text='Light'}" />
                        <ComboBoxItem Content="{loc:Tr Text='Dark'}" />
                    </ComboBox>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Text='Lets scripts and AI assistants list, search, read and copy your clipboard history with the bclip command. While this is on, any program running as you can read your history, so it is off by default.'}"
                    Glyph="&#xE756;"
                    Header="{loc:Tr Text='Command line (bclip)'}"
                    Keywords="{loc:Tr Text='CLI, terminal, scripts, automation, PATH'}">
                    <ToggleSwitch OnContent="{loc:Tr Text='On'}" OffContent="{loc:Tr Text='Off'}" IsOn="{x:Bind ViewModel.EnableCommandLine, Mode=TwoWay}" />
                    <controls:SettingsCard.Footer>
                        <StackPanel Spacing="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.CommandLineStatus, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <!--  Not in the Microsoft Store edition: there every terminal finds bclip through its app execution alias.  -->
