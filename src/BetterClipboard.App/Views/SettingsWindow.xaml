                    Header="{loc:Tr Text='Notepad++ unsaved tabs'}"
                    Keywords="{loc:Tr Text='editor, unsaved, backups, new tabs, text'}">
                    <ToggleSwitch OnContent="{loc:Tr Text='On'}" OffContent="{loc:Tr Text='Off'}" IsOn="{x:Bind ViewModel.KeepNotepadPlusPlusTabs, Mode=TwoWay}" />
                    <controls:SettingsCard.Footer>
