                </controls:SettingsCard>
                <!--
                    The prompt archives (ViewModel: SettingsViewModel.Prompts.cs). Robot glyph E99A, checked by rendering. Off keeps
                    what is stored; Delete stored… (every integration card has one, CLAUDE.md §2.43) is the way to remove it.
                -->
                <controls:SettingsCard
                    Description="{loc:Tr Text=&quot;Keeps every prompt you send in Claude Code, encrypted, in a Claude tab: newest first, searchable, one card per prompt with how often you sent it. Read from Claude Code's prompt history (pastes included) the moment Claude Code saves it, only the new bytes; Claude Code prunes its history after its cleanup period, BetterClipboard keeps it. Claude Code's files are never changed. Pause capturing skips prompts sent while paused; off stops reading and keeps what is stored.&quot;}"
                    Glyph="&#xE99A;"
                    Header="{loc:Tr Text='Claude Code prompts'}"
                    Keywords="{loc:Tr Text='AI, Anthropic, agent, chat, prompt history'}">
                    <ToggleSwitch OnContent="{loc:Tr Text='On'}" OffContent="{loc:Tr Text='Off'}" IsOn="{x:Bind ViewModel.KeepClaudeCodePrompts, Mode=TwoWay}" />
