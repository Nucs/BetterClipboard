                                Loaded="DeleteStoredButton_Loaded"
                                Tag="PowerShell" />
                        </StackPanel>
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Text=&quot;Command Prompt keeps no history file: a window's commands vanish when it closes. With this on, BetterClipboard reads open Command Prompt windows every 30 seconds (through a short helper process, only windows you opened) and keeps their commands, encrypted, in a Cmd tab. Pause capturing stops the keeping; off deletes what was kept.&quot;}"
                    Glyph="&#xE756;"
                    Header="{loc:Tr Text='Cmd tab (Command Prompt history)'}"
                    Keywords="{loc:Tr Text='Command Prompt, cmd.exe, terminal, shell, commands'}">
                    <ToggleSwitch OnContent="{loc:Tr Text='On'}" OffContent="{loc:Tr Text='Off'}" IsOn="{x:Bind ViewModel.ShowCmdTab, Mode=TwoWay}" />
                    <controls:SettingsCard.Footer>
                        <StackPanel Spacing="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
