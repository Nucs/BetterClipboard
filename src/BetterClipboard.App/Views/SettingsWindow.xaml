                <!--  E756 = CommandPrompt (checked by rendering): Win+R has no glyph of its own.  -->
                <controls:SettingsCard
                    Description="{loc:Tr Text=&quot;Windows keeps only your last 26 Win+R commands, in plain text. BetterClipboard keeps every one, encrypted, in a Run tab: each command shows up the moment you run it, and Ctrl+Enter runs it again. The first time, it imports the 26 Windows still remembers. Pause capturing, Ignored apps (add Win+R to skip them) and Forget forever apply. Windows' own list is never changed.&quot;}"
                    Glyph="&#xE756;"
                    Header="{loc:Tr Text='Win+R history'}"
                    Keywords="{loc:Tr Text='Run dialog, run box, commands, RunMRU'}">
                    <ToggleSwitch OnContent="{loc:Tr Text='On'}" OffContent="{loc:Tr Text='Off'}" IsOn="{x:Bind ViewModel.RecordRunHistory, Mode=TwoWay}" />
                    <controls:SettingsCard.Footer>
                        <StackPanel Spacing="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.RunHistoryStatus, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Button
                                Click="DeleteStored_Click"
                                Content="{loc:Tr Text='Delete stored…'}"
                                IsEnabled="{x:Bind ViewModel.Stored.RunHistory, Mode=OneWay}"
                                Loaded="DeleteStoredButton_Loaded"
                                Tag="RunHistory" />
                        </StackPanel>
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <!--  The shell tabs (CLAUDE.md §2.19). E756 = CommandPrompt, like the Run tab's commands.  -->
                <controls:SettingsCard
                    Description="{loc:Tr Text=&quot;The panel gets a Pwsh tab with every command you typed in PowerShell, newest first and searchable — also the ones older than the 4,096 PowerShell itself loads. It reads PowerShell's own history file (shared by Windows PowerShell and PowerShell 7) when the tab opens, and never changes it. A command is kept in your history only when you paste, copy or pin it there.&quot;}"
                    Glyph="&#xE756;"
                    Header="{loc:Tr Text='Pwsh tab (PowerShell history)'}"
                    Keywords="{loc:Tr Text='PowerShell, terminal, shell, commands, PSReadLine'}">
                    <ToggleSwitch OnContent="{loc:Tr Text='On'}" OffContent="{loc:Tr Text='Off'}" IsOn="{x:Bind ViewModel.ShowPowerShellTab, Mode=TwoWay}" />
                    <controls:SettingsCard.Footer>
                        <StackPanel Spacing="8">
                            <TextBlock
