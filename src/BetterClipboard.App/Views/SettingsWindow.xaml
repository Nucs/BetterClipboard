                  the panel's update button (the decision buttons, and below them the release notes); it is the accent
                  button while an update waits. E895 = Sync, the update button's glyph (checked by rendering).
                -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{loc:Tr Key=T22e2bada8f1c}" />
                <controls:SettingsCard
                    Description="{loc:Tr Key=T4cafc5ef31d8}"
                    Glyph="&#xE895;"
                    Header="{loc:Tr Key=T04fd6c4d82cd}">
