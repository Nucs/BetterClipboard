                    Header="{loc:Tr Text='Files opened in Notepad++'}"
                    Keywords="{loc:Tr Text='editor, recent files, file paths'}">
                    <ToggleSwitch OnContent="{loc:Tr Text='On'}" OffContent="{loc:Tr Text='Off'}" IsOn="{x:Bind ViewModel.RecordNotepadPlusPlusFiles, Mode=TwoWay}" />
                    <controls:SettingsCard.Footer>
