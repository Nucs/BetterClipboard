                <controls:SettingsCard
                    Description="{loc:Tr Text=&quot;Keeps every prompt you send in Codex (the app, the CLI, the IDE extension), encrypted, in a Codex tab. Read from Codex's session files and its CLI history as Codex writes them, only the new bytes; compressed session files are read too. Threads started by agents, codex exec runs and MCP sessions are left out: their prompts were written by programs. Codex's files are never changed.&quot;}"
                    Glyph="&#xE99A;"
                    Header="{loc:Tr Text='Codex prompts'}"
                    Keywords="{loc:Tr Text='AI, OpenAI, agent, chat, prompt history'}">
                    <ToggleSwitch OnContent="{loc:Tr Text='On'}" OffContent="{loc:Tr Text='Off'}" IsOn="{x:Bind ViewModel.KeepCodexPrompts, Mode=TwoWay}" />
                    <controls:SettingsCard.Footer>
                        <StackPanel Spacing="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.CodexPromptsStatus, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Button
                                Click="DeleteStored_Click"
                                Content="{loc:Tr Text='Delete stored…'}"
                                IsEnabled="{x:Bind ViewModel.Stored.Codex, Mode=OneWay}"
                                Loaded="DeleteStoredButton_Loaded"
                                Tag="Codex" />
                        </StackPanel>
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>

                <!--  App  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{loc:Tr Text='App'}" />
                <controls:SettingsCard
                    Description="{loc:Tr Text='Restart BetterClipboard to apply the language. History and custom names are not translated.'}"
                    Glyph="&#xE774;"
                    Header="{loc:Tr Text='Language'}"
                    Keywords="{loc:Tr Text='translation, interface language, locale'}">
                    <!--
                      "Use Windows setting" (the flag and name of the language it picks now), then every shipped
                      language with its flag, own name and English name (SettingsViewModel.LanguageOptions): a new
                      catalog shows up here by itself. The closed box shows the language in effect with its flag, and
                      "· Windows setting" after it while BetterClipboard follows Windows: LanguageOptionView draws each
                      row for its place, because a ComboBox draws its closed box with its items' template.
                      ItemsSource comes before SelectedIndex, so the index never meets an empty list.
                      "Restart now" shows once the saved language differs from the one on screen; it sits left of the
                      list, so the list does not move when it appears. A Grid, not a StackPanel: the card holds its
                      content to 380 px, and the list's column gets what the button leaves, so a long closed box ("English
                      · Windows setting" in Russian or Hebrew, beside a long "Restart now") trims its hint instead of
                      running past the card's edge with its chevron (seen in Hebrew, 2026-11-09).
                    -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            VerticalAlignment="Center"
                            Click="RestartForLanguage_Click"
                            Content="{loc:Tr Text='Restart now'}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.IsLanguageRestartPending, Mode=OneWay}" />
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="200"
                            AutomationProperties.Name="{loc:Tr Text='Language'}"
                            ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                            SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <!--  The view takes the row from its DataContext and draws it as a list row or as the closed box's choice.  -->
                                <DataTemplate x:DataType="vm:LanguageOptionViewModel">
                                    <views:LanguageOptionView />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{x:Bind ViewModel.LaunchAtStartupDescription, Mode=OneWay}"
