<?xml version="1.0" encoding="utf-8"?>
<!--
  Main/settings window (Mica, custom title bar). Sections mirror the Windows 11 Settings app so it
  feels native: Shortcut, History, Pasting, Privacy, Windows clipboard, Integrations, App, and Third
  party (credits and official links) at the bottom.
-->
<Window
    x:Class="BetterClipboard.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BetterClipboard.App.Controls"
    xmlns:vm="using:BetterClipboard.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root">
        <Grid.Resources>
            <!--
              One project in Third party (both cards): name + credit, what it is for, and its official link. The top
              border divides the rows; on the first row it separates the list from the card's header. The link opens
              in the browser through NavigateUri; its accessible name says which project it belongs to, since bare
              sites repeat (learn.microsoft.com twice), and the tooltip shows the whole address.
            -->
            <DataTemplate x:Key="ThirdPartyRowTemplate" x:DataType="vm:ThirdPartyItemViewModel">
                <Grid
                    Padding="0,8,0,8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <!--  The runs stay on one line: whitespace between them would become text.  -->
                        <TextBlock TextWrapping="Wrap"><Run Text="{x:Bind Name}" /><Run FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind CreditRun}" /></TextBlock>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Use}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <HyperlinkButton
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind LinkName}"
                        NavigateUri="{x:Bind Link}"
                        ToolTipService.ToolTip="{x:Bind LinkTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind LinkText}" />
                            <!--  E8A7 = OpenInNewWindow: the link leaves the app for the browser.  -->
                            <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                        </StackPanel>
                    </HyperlinkButton>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Title bar  -->
        <Grid
            x:Name="TitleBar"
            Height="40"
            Padding="16,0,0,0"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/AppIcon32.png" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="BetterClipboard" />
        </Grid>

        <ScrollViewer
            x:Name="Scroller"
            Grid.Row="1"
            Padding="0,0,0,24"
            IsTabStop="True">
            <StackPanel
                MaxWidth="880"
                Padding="32,8,32,24"
                HorizontalAlignment="Stretch">

                <!--  Hero  -->
                <Grid Margin="0,8,0,4" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Width="72"
                        Height="72"
                        VerticalAlignment="Top"
                        Source="ms-appx:///Assets/AppIcon.png" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="BetterClipboard" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Everything you copy — kept, searchable and pinned. Even after a restart."
                            TextWrapping="Wrap" />
                        <StackPanel
                            Margin="0,6,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Border Style="{StaticResource ChipBorderStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        Fill="{x:Bind CaptureDotBrush(ViewModel.IsCapturePaused), Mode=OneWay}" />
                                    <TextBlock FontSize="12" Text="{x:Bind CaptureText(ViewModel.IsCapturePaused), Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ChipBorderStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE765;" />
                                    <TextBlock FontSize="12" Text="{x:Bind ViewModel.OpenHotkey, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ChipBorderStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE81C;" />
                                    <TextBlock FontSize="12" Text="{x:Bind ViewModel.StatsText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!--  Shortcut  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Shortcut" />
                <controls:SettingsCard
                    Description="{x:Bind ViewModel.HotkeyStatus, Mode=OneWay}"
                    Glyph="&#xE765;"
                    Header="Open BetterClipboard">
                    <StackPanel Spacing="4">
                        <!--
                          A TextBox + presets menu, not an editable ComboBox: an editable ComboBox fills its
                          inner text box from SelectedItem when its template loads, so a bound Text value
                          (the saved shortcut) showed up blank. TextBox.Text binds reliably; the two-way
                          binding commits on focus loss, and Enter commits too (HotkeyBox_KeyDown).
                        -->
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="HotkeyBox"
                                MinWidth="160"
                                AutomationProperties.Name="Shortcut that opens BetterClipboard"
                                KeyDown="HotkeyBox_KeyDown"
                                PlaceholderText="Win+V"
                                Text="{x:Bind ViewModel.OpenHotkey, Mode=TwoWay}" />
                            <DropDownButton
                                Grid.Column="1"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="Suggested shortcuts"
                                ToolTipService.ToolTip="Suggested shortcuts">
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="HotkeyPresetsMenu" Placement="BottomEdgeAlignedRight" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </Grid>
                        <TextBlock
                            MaxWidth="220"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.HotkeyError, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind HasText(ViewModel.HotkeyError), Mode=OneWay}" />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Win+V belongs to Windows. When on, BetterClipboard intercepts exactly your shortcut with a keyboard hook while it runs — quit BetterClipboard and Windows gets it back instantly."
                    Glyph="&#xEDA7;"
                    Header="Take over shortcuts owned by Windows">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.UseKeyboardHookFallback, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Advanced: tells Explorer not to register Win+V at all (DisabledHotkeys), so no hook is needed. Restarts Explorer. While BetterClipboard is not running, Win+V then does nothing."
                    Glyph="&#xEC50;"
                    Header="Release Win+V from Explorer">
                    <Button Click="ReleaseWinV_Click" Content="{x:Bind ReleaseWinVText(ViewModel.IsWinVReleased), Mode=OneWay}" />
                </controls:SettingsCard>

                <!--  History  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="History" />
                <controls:SettingsCard
                    Description="The oldest items are removed beyond this count; pinned items and items in groups are kept and not counted. 0 = unlimited. (Win+V keeps 25.)"
                    Glyph="&#xE81C;"
                    Header="Maximum items">
                    <NumberBox
                        MinWidth="140"
                        LargeChange="1000"
                        Maximum="1000000"
                        Minimum="0"
                        SmallChange="100"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.MaxItems, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Items not used for this many days are removed, except pinned items and items in groups. 0 = keep forever."
                    Glyph="&#xE917;"
                    Header="Keep items for (days)">
                    <NumberBox
                        MinWidth="140"
                        Maximum="36500"
                        Minimum="0"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.RetentionDays, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Copies larger than this are not recorded. (Win+V caps at 4 MB.)"
                    Glyph="&#xE7C3;"
                    Header="Largest item (MB)">
                    <NumberBox
                        MinWidth="140"
                        Maximum="1024"
                        Minimum="1"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.MaxItemSizeMB, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Total size budget for history outside pins and groups; the least recently used items go first. 0 = unlimited."
                    Glyph="&#xE8B7;"
                    Header="History size budget (MB)">
                    <NumberBox
                        MinWidth="140"
                        LargeChange="1024"
                        Maximum="1048576"
                        Minimum="0"
                        SmallChange="256"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.MaxTotalSizeMB, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Screenshots and copied images, with thumbnails."
                    Glyph="&#xE91B;"
                    Header="Record images">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.CaptureImages, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Files copied in Explorer (their paths — not the file contents)."
                    Glyph="&#xE8E5;"
                    Header="Record copied files">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.CaptureFiles, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Also keep app-specific formats (Office, IDEs, design tools) for pixel-perfect pastes. Uses much more disk space."
                    Glyph="&#xE943;"
                    Header="Preserve app-specific formats">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.PreserveAllFormats, Mode=TwoWay}" />
                </controls:SettingsCard>

                <!--  Pasting  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Pasting" />
                <controls:SettingsCard
                    Description="After you pick an item, paste it into the app you came from (like Win+V). Off = only copy it."
                    Glyph="&#xE77F;"
                    Header="Paste after choosing an item">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.PasteOnSelect, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Items you paste from history jump back to the top."
                    Glyph="&#xE72A;"
                    Header="Move pasted items to the top">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.MoveToTopOnPaste, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Pinned items are listed before everything else."
                    Glyph="&#xE840;"
                    Header="Show pinned items first">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.PinnedOnTop, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Where the clipboard panel opens."
                    Glyph="&#xE8A7;"
                    Header="Panel position">
                    <ComboBox MinWidth="180" SelectedIndex="{x:Bind ViewModel.PlacementIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Next to the text cursor" />
                        <ComboBoxItem Content="Next to the mouse" />
                        <ComboBoxItem Content="Center of the screen" />
                    </ComboBox>
                </controls:SettingsCard>

                <!--  Privacy  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Privacy" />
                <controls:SettingsCard
                    Description="Stop recording new copies until you resume. Password managers that mark their copies as private are always skipped."
                    Glyph="&#xE769;"
                    Header="Pause capturing">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsCapturePaused, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Never record copies from these apps (process names, one per line). Comes filled with known password managers and authenticator apps (1Password, Bitwarden, KeePass, KeePassXC, LastPass, Proton Pass, RoboForm and many more); delete any you do want recorded and they stay deleted. Managers that work only inside the browser cannot be told apart from the browser."
                    Glyph="&#xEA18;"
                    Header="Ignored apps">
                    <controls:SettingsCard.Footer>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- MaxHeight + scrolling: the built-in list alone is ~65 lines. -->
                            <TextBox
                                MinHeight="64"
                                MaxHeight="240"
                                AcceptsReturn="True"
                                PlaceholderText="KeePass"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                Text="{x:Bind ViewModel.IgnoredAppsText, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Spacing="8">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Click="AddKnownPasswordManagers_Click"
                                    Content="Add known password managers"
                                    ToolTipService.ToolTip="Puts back every known password manager and authenticator that is missing from the list, then saves it." />
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Click="ApplyIgnoredApps_Click"
                                    Content="Apply" />
                            </StackPanel>
                        </Grid>
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Items you forget forever (in the panel: right-click an item › Forget forever) are deleted and never recorded again, whichever app copies them. Line endings and spaces around the text don't matter; everything else has to match. Only a fingerprint of each is kept, encrypted with your history, plus its kind, length and source app so you can tell them apart here."
                    Glyph="&#xE733;"
                    Header="Forgotten forever">
                    <Button
                        Click="AllowAllForgotten_Click"
                        Content="Allow all again…"
                        IsEnabled="{x:Bind ViewModel.HasForgotten, Mode=OneWay}" />
                    <controls:SettingsCard.Footer>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ForgottenSummary, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <!--  Bounded like the ignored-apps box, so a long list scrolls instead of stretching the page.  -->
                            <ScrollViewer
                                MaxHeight="280"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{x:Bind Visible(ViewModel.HasForgotten), Mode=OneWay}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Forgotten}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ForgottenItemViewModel">
                                            <Grid Padding="0,6,4,6" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Details}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="{x:Bind AllowAgainName}"
                                                    Click="AllowAgain_Click"
                                                    Content="Allow again"
                                                    Tag="{x:Bind Id}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{x:Bind ViewModel.EncryptionStatus}"
                    Glyph="&#xE72E;"
                    Header="Encrypted history" />
                <controls:SettingsCard
                    Description="{x:Bind ViewModel.CaptureReliabilityText, Mode=OneWay}"
                    Glyph="&#xE9D9;"
                    Header="Capture reliability" />
                <controls:SettingsCard
                    Description="Delete history permanently. Clearing keeps pinned items and items in groups; 'Everything' removes them too (the groups stay, empty). Forgotten items stay forgotten either way."
                    Glyph="&#xE74D;"
                    Header="Clear history">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="ClearUnpinned_Click" Content="Clear" />
                        <Button Click="ClearAll_Click" Content="Everything…" />
                    </StackPanel>
                </controls:SettingsCard>

                <!--  Windows clipboard  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Windows clipboard" />
                <controls:SettingsCard
                    Description="{x:Bind ViewModel.WindowsHistoryStatus, Mode=OneWay}"
                    Glyph="&#xE77F;"
                    Header="Windows' own clipboard history">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsWindowsHistoryEnabled, Mode=OneWay}" Toggled="WindowsHistory_Toggled" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Bring in everything Win+V still remembers, including its pinned items (decrypted from Windows' pinned store with your own account)."
                    Glyph="&#xE8B5;"
                    Header="Import from Windows">
                    <Button
                        Click="ImportNow_Click"
                        Content="Import now"
                        IsEnabled="{x:Bind Not(ViewModel.IsImporting), Mode=OneWay}" />
                    <controls:SettingsCard.Footer>
                        <StackPanel Spacing="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ImportStatus, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind HasText(ViewModel.ImportStatus), Mode=OneWay}" />
                            <CheckBox Content="Import automatically every time BetterClipboard starts" IsChecked="{x:Bind ViewModel.ImportWindowsHistoryOnStartup, Mode=TwoWay}" />
                        </StackPanel>
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>

                <!--  Integrations  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Integrations" />
                <controls:SettingsCard
                    Description="Every screenshot ShareX saves shows up in your history the moment the file is written, and the panel gets a ShareX tab. Pause capturing, Ignored apps (add ShareX to skip it) and the size limit apply to screenshots too."
                    Glyph="&#xE722;"
                    Header="ShareX screenshots">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.ImportShareXScreenshots, Mode=TwoWay}" />
                    <controls:SettingsCard.Footer>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.ShareXStatus, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="While voidtools Everything is installed or running, the panel gets an Everything tab: the files and folders you open from Everything, newest first, next to everything copied from it. BetterClipboard only reads from Everything. A file is kept in your history only when you paste, copy or pin it there."
                    Glyph="&#xE721;"
                    Header="Everything">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.ShowEverythingTab, Mode=TwoWay}" />
                    <controls:SettingsCard.Footer>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.EverythingStatus, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <!--  E756 = CommandPrompt (checked by rendering): Win+R has no glyph of its own.  -->
                <controls:SettingsCard
                    Description="Windows keeps only your last 26 Win+R commands, in plain text. BetterClipboard keeps every one, encrypted, in a Run tab: each command shows up the moment you run it, and Ctrl+Enter runs it again. The first time, it imports the 26 Windows still remembers. Pause capturing, Ignored apps (add Win+R to skip them) and Forget forever apply. Windows' own list is never changed."
                    Glyph="&#xE756;"
                    Header="Win+R history">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.RecordRunHistory, Mode=TwoWay}" />
                    <controls:SettingsCard.Footer>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.RunHistoryStatus, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <!--  The shell tabs (CLAUDE.md §2.19). E756 = CommandPrompt, like the Run tab's commands.  -->
                <controls:SettingsCard
                    Description="The panel gets a Pwsh tab with every command you typed in PowerShell, newest first and searchable — also the ones older than the 4,096 PowerShell itself loads. It reads PowerShell's own history file (shared by Windows PowerShell and PowerShell 7) when the tab opens, and never changes it. A command is kept in your history only when you paste, copy or pin it there."
                    Glyph="&#xE756;"
                    Header="Pwsh tab (PowerShell history)">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.ShowPowerShellTab, Mode=TwoWay}" />
                    <controls:SettingsCard.Footer>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.PowerShellHistoryStatus, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Command Prompt keeps no history file: a window's commands vanish when it closes. With this on, BetterClipboard reads open Command Prompt windows every 30 seconds (through a short helper process, only windows you opened) and keeps their commands, encrypted, in a Cmd tab. Pause capturing stops the keeping; off deletes what was kept."
                    Glyph="&#xE756;"
                    Header="Cmd tab (Command Prompt history)">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.ShowCmdTab, Mode=TwoWay}" />
                    <controls:SettingsCard.Footer>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.CmdHistoryStatus, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <!--
                    The prompt archives (ViewModel: SettingsViewModel.Prompts.cs). Robot glyph E99A, checked by rendering. Off keeps
                    what is stored; "Delete stored prompts…" (confirmed) is the way to remove it.
                -->
                <controls:SettingsCard
                    Description="Keeps every prompt you send in Claude Code, encrypted, in a Claude tab: newest first, searchable, one card per prompt with how often you sent it. Read from Claude Code's prompt history (pastes included) the moment Claude Code saves it, only the new bytes; Claude Code prunes its history after its cleanup period, BetterClipboard keeps it. Claude Code's files are never changed. Pause capturing skips prompts sent while paused; off stops reading and keeps what is stored."
                    Glyph="&#xE99A;"
                    Header="Claude Code prompts">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.KeepClaudeCodePrompts, Mode=TwoWay}" />
                    <controls:SettingsCard.Footer>
                        <StackPanel Spacing="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ClaudeCodePromptsStatus, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Button
                                Click="DeleteClaudeCodePrompts_Click"
                                Content="Delete stored prompts…"
                                IsEnabled="{x:Bind ViewModel.HasClaudeCodePrompts, Mode=OneWay}" />
                        </StackPanel>
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Keeps every prompt you send in Codex (the app, the CLI, the IDE extension), encrypted, in a Codex tab. Read from Codex's session files and its CLI history as Codex writes them, only the new bytes; compressed session files are read too. Threads started by agents, codex exec runs and MCP sessions are left out: their prompts were written by programs. Codex's files are never changed."
                    Glyph="&#xE99A;"
                    Header="Codex prompts">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.KeepCodexPrompts, Mode=TwoWay}" />
                    <controls:SettingsCard.Footer>
                        <StackPanel Spacing="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.CodexPromptsStatus, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Button
                                Click="DeleteCodexPrompts_Click"
                                Content="Delete stored prompts…"
                                IsEnabled="{x:Bind ViewModel.HasCodexPrompts, Mode=OneWay}" />
                        </StackPanel>
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>

                <!--  App  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="App" />
                <controls:SettingsCard
                    Description="Start quietly in the notification area when you sign in."
                    Glyph="&#xE7E8;"
                    Header="Start with Windows">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.LaunchAtStartup, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Light, dark, or follow Windows."
                    Glyph="&#xE771;"
                    Header="Theme">
                    <ComboBox MinWidth="180" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Use Windows setting" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Lets scripts and AI assistants list, search, read and copy your clipboard history with the bclip command. While this is on, any program running as you can read your history, so it is off by default."
                    Glyph="&#xE756;"
                    Header="Command line (bclip)">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.EnableCommandLine, Mode=TwoWay}" />
                    <controls:SettingsCard.Footer>
                        <StackPanel Spacing="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.CommandLineStatus, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Button
                                Click="AddCommandLineToPath_Click"
                                Content="Add bclip to PATH"
                                IsEnabled="{x:Bind ViewModel.CanAddCommandLineToPath, Mode=OneWay}" />
                        </StackPanel>
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{x:Bind ViewModel.DataFolder}"
                    Glyph="&#xE8B7;"
                    Header="Data folder">
                    <Button Click="OpenDataFolder_Click" Content="Open" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{x:Bind ViewModel.VersionText}"
                    Glyph="&#xE946;"
                    Header="About BetterClipboard">
                    <Button Click="Exit_Click" Content="Exit BetterClipboard" />
                </controls:SettingsCard>

                <!--
                  Third party: the apps BetterClipboard works with and the components it ships, each with its official
                  link. The rows come from Core's ThirdPartyCatalog, whose tests keep it in step with
                  THIRD-PARTY-NOTICES.md and with the packages the app restores (CLAUDE.md, "Third party" section).
                  EA86 = Puzzle, E8F1 = Library (both checked by rendering).
                -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Third party" />
                <controls:SettingsCard
                    Description="Apps by other makers that BetterClipboard reads from while their setting above is on. BetterClipboard is not affiliated with them; get them from their official sites."
                    Glyph="&#xEA86;"
                    Header="Works with">
                    <controls:SettingsCard.Footer>
                        <ItemsControl
                            AutomationProperties.Name="Apps BetterClipboard works with"
                            IsTabStop="False"
                            ItemTemplate="{StaticResource ThirdPartyRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.WorksWith}" />
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="The components inside BetterClipboard, each under its own license."
                    Glyph="&#xE8F1;"
                    Header="Built with">
                    <HyperlinkButton
                        AutomationProperties.Name="License notices"
                        NavigateUri="{x:Bind ViewModel.NoticesLink}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.NoticesLink.AbsoluteUri}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="License notices" />
                            <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                        </StackPanel>
                    </HyperlinkButton>
                    <controls:SettingsCard.Footer>
                        <ItemsControl
                            AutomationProperties.Name="Components inside BetterClipboard"
                            IsTabStop="False"
                            ItemTemplate="{StaticResource ThirdPartyRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.BuiltWith}" />
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
