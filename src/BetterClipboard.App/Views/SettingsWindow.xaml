<?xml version="1.0" encoding="utf-8"?>
<!--
  Main/settings window (Mica, custom title bar). Sections mirror the Windows 11 Settings app so it
  feels native: Shortcut, History, Pasting, Privacy, Windows clipboard, Integrations, App, and Third
  party (credits and official links) at the bottom.
-->
<Window
    x:Class="BetterClipboard.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:BetterClipboard.App.Localization"
    xmlns:controls="using:BetterClipboard.App.Controls"
    xmlns:vm="using:BetterClipboard.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root">
        <Grid.Resources>
            <!--
              One project in Third party (both cards): name + credit, what it is for, and its official link. The top
              border divides the rows; on the first row it separates the list from the card's header. The link opens
              in the browser through NavigateUri; its accessible name says which project it belongs to, since bare
              sites repeat (learn.microsoft.com twice), and the tooltip shows the whole address.
            -->
            <DataTemplate x:Key="ThirdPartyRowTemplate" x:DataType="vm:ThirdPartyItemViewModel">
                <Grid
                    Padding="0,8,0,8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <!--  The runs stay on one line: whitespace between them would become text.  -->
                        <TextBlock TextWrapping="Wrap"><Run Text="{x:Bind Name}" /><Run FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind CreditRun}" /></TextBlock>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Use}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <HyperlinkButton
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind LinkName}"
                        NavigateUri="{x:Bind Link}"
                        ToolTipService.ToolTip="{x:Bind LinkTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind LinkText}" />
                            <!--  E8A7 = OpenInNewWindow: the link leaves the app for the browser.  -->
                            <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                        </StackPanel>
                    </HyperlinkButton>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Title bar  -->
        <Grid
            x:Name="TitleBar"
            Height="40"
            Padding="16,0,0,0"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/AppIcon32.png" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="BetterClipboard" />
        </Grid>

        <ScrollViewer
            x:Name="Scroller"
            Grid.Row="1"
            Padding="0,0,0,24"
            IsTabStop="True">
            <StackPanel
                MaxWidth="880"
                Padding="32,8,32,24"
                HorizontalAlignment="Stretch">

                <!--  Hero  -->
                <Grid Margin="0,8,0,4" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Width="72"
                        Height="72"
                        VerticalAlignment="Top"
                        Source="ms-appx:///Assets/AppIcon.png" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="BetterClipboard" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{loc:Tr Key=Tb6c6e5318383}"
                            TextWrapping="Wrap" />
                        <StackPanel
                            Margin="0,6,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Border Style="{StaticResource ChipBorderStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        Fill="{x:Bind CaptureDotBrush(ViewModel.IsCapturePaused), Mode=OneWay}" />
                                    <TextBlock FontSize="12" Text="{x:Bind CaptureText(ViewModel.IsCapturePaused), Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ChipBorderStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE765;" />
                                    <TextBlock FontSize="12" Text="{x:Bind ViewModel.HotkeysSummary, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ChipBorderStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE81C;" />
                                    <TextBlock FontSize="12" Text="{x:Bind ViewModel.StatsText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!--  Shortcut  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{loc:Tr Key=T5753ea3780f3}" />
                <controls:SettingsCard
                    Description="{x:Bind ViewModel.HotkeyStatus, Mode=OneWay}"
                    Glyph="&#xE765;"
                    Header="{loc:Tr Key=T6f6f44619212}">
                    <StackPanel Spacing="4">
                        <!--
                          The box adds a shortcut to the list below: Enter or the Add button (HotkeyBox_KeyDown,
                          AddHotkey_Click), never focus loss, so a half-typed shortcut never becomes a global hotkey.
                          While it has focus in the active window it also records: any key pressed with Ctrl, Alt or
                          Win (or a key that works alone, such as F9 or a media key) is written into it by the
                          recorder's keyboard hook (HotkeyBox_GotFocus/LostFocus, Windows.Input.HotkeyRecorder), even
                          when Explorer or BetterClipboard itself owns that shortcut; plain typing still types.
                          A TextBox + presets menu, not an editable ComboBox: an editable ComboBox fills its inner
                          text box from SelectedItem when its template loads, so a bound Text value showed up blank.
                        -->
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="HotkeyBox"
                                MinWidth="190"
                                AutomationProperties.HelpText="Press the keys of the shortcut, or type its name, then press Enter."
                                AutomationProperties.Name="{loc:Tr Key=Ta61a1d57d437}"
                                GotFocus="HotkeyBox_GotFocus"
                                KeyDown="HotkeyBox_KeyDown"
                                LostFocus="HotkeyBox_LostFocus"
                                PlaceholderText="{loc:Tr Key=T80a48ba602f2}"
                                Text="{x:Bind ViewModel.NewHotkeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="{loc:Tr Key=T239314aefce6}"
                                Click="AddHotkey_Click"
                                Content="{loc:Tr Key=T9fd728c66c9a}" />
                            <!--
                              Presets, then "Used before" (AppSettings.HotkeyHistory), rebuilt each time the menu opens.
                              Both are toggles: a checked one is in the list, and picking it again removes it.
                            -->
                            <DropDownButton
                                Grid.Column="2"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="{loc:Tr Key=T1dea1791b63a}"
                                ToolTipService.ToolTip="{loc:Tr Key=T28526ce4685b}">
                                <DropDownButton.Flyout>
                                    <MenuFlyout
                                        x:Name="HotkeyPresetsMenu"
                                        Opening="HotkeyPresetsMenu_Opening"
                                        Placement="BottomEdgeAlignedRight" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </Grid>
                        <TextBlock
                            MaxWidth="300"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.HotkeyError, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind HasText(ViewModel.HotkeyError), Mode=OneWay}" />
                        <TextBlock
                            MaxWidth="300"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.HotkeyHint, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind HasText(ViewModel.HotkeyHint), Mode=OneWay}" />
                    </StackPanel>
                    <controls:SettingsCard.Footer>
                        <!--  One row per shortcut, main one first: its state, and Remove (disabled for the only one).  -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Hotkeys}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HotkeyItemViewModel">
                                    <Grid
                                        Padding="0,6,4,6"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Text}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Status}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind WorkingVisibility}" />
                                            <TextBlock
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Status}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind ProblemVisibility}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind RemoveName}"
                                            Click="RemoveHotkey_Click"
                                            Content="{loc:Tr Key=Tc3812fc4acb8}"
                                            IsEnabled="{x:Bind CanRemove}"
                                            Tag="{x:Bind Text}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <!--
                  Where the shortcut opens the panel (AppSettings.Placement + CenterOnMainScreen, mapped by
                  SettingsViewModel.PlacementIndex). Right under the shortcuts since 2026-11-08: under Pasting it went
                  unnoticed. Next to the text cursor, next to the mouse, centered on the main screen, centered on the
                  screen the user is typing on (FlyoutPositioner.ChooseScreen).
                -->
                <controls:SettingsCard
                    Description="{loc:Tr Key=T88640766017a}"
                    Glyph="&#xE8A7;"
                    Header="{loc:Tr Key=T894d7f01eb87}">
                    <ComboBox MinWidth="180" SelectedIndex="{x:Bind ViewModel.PlacementIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{loc:Tr Key=T063543517b31}" />
                        <ComboBoxItem Content="{loc:Tr Key=Tda7ca90ff4a1}" />
                        <ComboBoxItem Content="{loc:Tr Key=Ted615dd586a6}" />
                        <ComboBoxItem Content="{loc:Tr Key=T4b75609443c3}" />
                    </ComboBox>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Key=Ta7f11ff9cde7}"
                    Glyph="&#xEDA7;"
                    Header="{loc:Tr Key=T4a1dc53d09c1}">
                    <ToggleSwitch OnContent="{loc:Tr Key=T130011756125}" OffContent="{loc:Tr Key=Tca7981b46ecf}" IsOn="{x:Bind ViewModel.UseKeyboardHookFallback, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Key=T783ba192f002}"
                    Glyph="&#xEC50;"
                    Header="{loc:Tr Key=T9e83803aa48f}">
                    <Button
                        Click="ReleaseFromExplorer_Click"
                        Content="{x:Bind ViewModel.ExplorerReleaseButtonText, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanChangeExplorerRelease, Mode=OneWay}" />
                    <controls:SettingsCard.Footer>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.ExplorerReleaseStatus, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>

                <!--  History  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{loc:Tr Key=T0e7696009337}" />
                <controls:SettingsCard
                    Description="{loc:Tr Key=T64e67f12ffd7}"
                    Glyph="&#xE81C;"
                    Header="{loc:Tr Key=T42e5c702ae42}">
                    <NumberBox
                        MinWidth="140"
                        LargeChange="1000"
                        Maximum="1000000"
                        Minimum="0"
                        SmallChange="100"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.MaxItems, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Key=Ta2302c232999}"
                    Glyph="&#xE917;"
                    Header="{loc:Tr Key=T602c7bafd9d6}">
                    <NumberBox
                        MinWidth="140"
                        Maximum="36500"
                        Minimum="0"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.RetentionDays, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Key=Td35bd4dca3b0}"
                    Glyph="&#xE7C3;"
                    Header="{loc:Tr Key=Td610b253d8a7}">
                    <NumberBox
                        MinWidth="140"
                        Maximum="1024"
                        Minimum="1"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.MaxItemSizeMB, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Key=T488d84daaad3}"
                    Glyph="&#xE8B7;"
                    Header="{loc:Tr Key=Tbd66f239fde2}">
                    <NumberBox
                        MinWidth="140"
                        LargeChange="1024"
                        Maximum="1048576"
                        Minimum="0"
                        SmallChange="256"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.MaxTotalSizeMB, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Key=Ta4809902b7ad}"
                    Glyph="&#xE91B;"
                    Header="{loc:Tr Key=Tf4fa657ed328}">
                    <ToggleSwitch OnContent="{loc:Tr Key=T130011756125}" OffContent="{loc:Tr Key=Tca7981b46ecf}" IsOn="{x:Bind ViewModel.CaptureImages, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Key=Te09de8c2cd30}"
                    Glyph="&#xE8E5;"
                    Header="{loc:Tr Key=T7a6a36e38c31}">
                    <ToggleSwitch OnContent="{loc:Tr Key=T130011756125}" OffContent="{loc:Tr Key=Tca7981b46ecf}" IsOn="{x:Bind ViewModel.CaptureFiles, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Key=T9b879c1c1028}"
                    Glyph="&#xE943;"
                    Header="{loc:Tr Key=T331ea7b7965e}">
                    <ToggleSwitch OnContent="{loc:Tr Key=T130011756125}" OffContent="{loc:Tr Key=Tca7981b46ecf}" IsOn="{x:Bind ViewModel.PreserveAllFormats, Mode=TwoWay}" />
                </controls:SettingsCard>

                <!--  Pasting  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{loc:Tr Key=T32b02dac5489}" />
                <controls:SettingsCard
                    Description="{loc:Tr Key=Tea00ebbf8563}"
                    Glyph="&#xE77F;"
                    Header="{loc:Tr Key=Tc8631cd93ef3}">
                    <ToggleSwitch OnContent="{loc:Tr Key=T130011756125}" OffContent="{loc:Tr Key=Tca7981b46ecf}" IsOn="{x:Bind ViewModel.PasteOnSelect, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Key=Tdfc9fe90ac3b}"
                    Glyph="&#xE72A;"
                    Header="{loc:Tr Key=T154354bfb90f}">
                    <ToggleSwitch OnContent="{loc:Tr Key=T130011756125}" OffContent="{loc:Tr Key=Tca7981b46ecf}" IsOn="{x:Bind ViewModel.MoveToTopOnPaste, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Key=T7ffed93d48ee}"
                    Glyph="&#xE840;"
                    Header="{loc:Tr Key=T4ab0ecb908e1}">
                    <ToggleSwitch OnContent="{loc:Tr Key=T130011756125}" OffContent="{loc:Tr Key=Tca7981b46ecf}" IsOn="{x:Bind ViewModel.PinnedOnTop, Mode=TwoWay}" />
                </controls:SettingsCard>

                <!--  Privacy  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{loc:Tr Key=T54a57c3147c4}" />
                <controls:SettingsCard
                    Description="{loc:Tr Key=T76d6d31cb5a9}"
                    Glyph="&#xE769;"
                    Header="{loc:Tr Key=T2bb9b17ce493}">
                    <ToggleSwitch OnContent="{loc:Tr Key=T130011756125}" OffContent="{loc:Tr Key=Tca7981b46ecf}" IsOn="{x:Bind ViewModel.IsCapturePaused, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Key=Ta103e3e5bea9}"
                    Glyph="&#xEA18;"
                    Header="{loc:Tr Key=Tac7a423f1531}">
                    <controls:SettingsCard.Footer>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- MaxHeight + scrolling: the built-in list alone is ~65 lines. -->
                            <TextBox
                                MinHeight="64"
                                MaxHeight="240"
                                AcceptsReturn="True"
                                PlaceholderText="KeePass"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                Text="{x:Bind ViewModel.IgnoredAppsText, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Spacing="8">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Click="AddKnownPasswordManagers_Click"
                                    Content="{loc:Tr Key=Tcd058b100c10}"
                                    ToolTipService.ToolTip="{loc:Tr Key=T8569b837987c}" />
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Click="ApplyIgnoredApps_Click"
                                    Content="{loc:Tr Key=T31e392d1c037}" />
                            </StackPanel>
                        </Grid>
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Key=T08dbe40b4edf}"
                    Glyph="&#xE733;"
                    Header="{loc:Tr Key=T573c341b63a5}">
                    <Button
                        Click="AllowAllForgotten_Click"
                        Content="{loc:Tr Key=Tacc0ac378678}"
                        IsEnabled="{x:Bind ViewModel.HasForgotten, Mode=OneWay}" />
                    <controls:SettingsCard.Footer>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ForgottenSummary, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <!--  Bounded like the ignored-apps box, so a long list scrolls instead of stretching the page.  -->
                            <ScrollViewer
                                MaxHeight="280"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{x:Bind Visible(ViewModel.HasForgotten), Mode=OneWay}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Forgotten}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ForgottenItemViewModel">
                                            <Grid Padding="0,6,4,6" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Details}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="{x:Bind AllowAgainName}"
                                                    Click="AllowAgain_Click"
                                                    Content="{loc:Tr Key=Tc01a661b40b9}"
                                                    Tag="{x:Bind Id}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{x:Bind ViewModel.EncryptionStatus}"
                    Glyph="&#xE72E;"
                    Header="{loc:Tr Key=T89808f3e4651}" />
                <controls:SettingsCard
                    Description="{x:Bind ViewModel.CaptureReliabilityText, Mode=OneWay}"
                    Glyph="&#xE9D9;"
                    Header="{loc:Tr Key=T95bde9396a25}" />
                <controls:SettingsCard
                    Description="{loc:Tr Key=T00a57b01f388}"
                    Glyph="&#xE74D;"
                    Header="{loc:Tr Key=T496121494e4a}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="ClearUnpinned_Click" Content="{loc:Tr Key=T83b12c2216ef}" />
                        <Button Click="ClearAll_Click" Content="{loc:Tr Key=T5dcd2e9debc0}" />
                    </StackPanel>
                </controls:SettingsCard>

                <!--  Windows clipboard  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{loc:Tr Key=Tc340136f2afb}" />
                <controls:SettingsCard
                    Description="{x:Bind ViewModel.WindowsHistoryStatus, Mode=OneWay}"
                    Glyph="&#xE77F;"
                    Header="{loc:Tr Key=T577163190596}">
                    <ToggleSwitch OnContent="{loc:Tr Key=T130011756125}" OffContent="{loc:Tr Key=Tca7981b46ecf}" IsOn="{x:Bind ViewModel.IsWindowsHistoryEnabled, Mode=OneWay}" Toggled="WindowsHistory_Toggled" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Key=T531e9e2ae1b9}"
                    Glyph="&#xE8B5;"
                    Header="{loc:Tr Key=T7dda26ca4a36}">
                    <Button
                        Click="ImportNow_Click"
                        Content="{loc:Tr Key=T6da9285b1e4f}"
                        IsEnabled="{x:Bind Not(ViewModel.IsImporting), Mode=OneWay}" />
                    <controls:SettingsCard.Footer>
                        <StackPanel Spacing="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ImportStatus, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind HasText(ViewModel.ImportStatus), Mode=OneWay}" />
                            <CheckBox Content="{loc:Tr Key=T6505a4370f6c}" IsChecked="{x:Bind ViewModel.ImportWindowsHistoryOnStartup, Mode=TwoWay}" />
                        </StackPanel>
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>

                <!--  Integrations  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{loc:Tr Key=T090512d93fcc}" />
                <controls:SettingsCard
                    Description="{loc:Tr Key=T45ec570e7014}"
                    Glyph="&#xE722;"
                    Header="{loc:Tr Key=Tdb43cff8589c}">
                    <ToggleSwitch OnContent="{loc:Tr Key=T130011756125}" OffContent="{loc:Tr Key=Tca7981b46ecf}" IsOn="{x:Bind ViewModel.ImportShareXScreenshots, Mode=TwoWay}" />
                    <controls:SettingsCard.Footer>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.ShareXStatus, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <!--  Windows' own screenshots (CLAUDE.md §2.18). E8C6 = Cut, a pair of scissors (checked by rendering).  -->
                <controls:SettingsCard
                    Description="{loc:Tr Key=Tc0c8ce512db7}"
                    Glyph="&#xE8C6;"
                    Header="{loc:Tr Key=Td2f495ea09d9}">
                    <ToggleSwitch OnContent="{loc:Tr Key=T130011756125}" OffContent="{loc:Tr Key=Tca7981b46ecf}" IsOn="{x:Bind ViewModel.ImportWindowsScreenshots, Mode=TwoWay}" />
                    <controls:SettingsCard.Footer>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.SnippingStatus, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </controls:SettingsCard.Footer>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{loc:Tr Key=T60a6973d9fca}"
                    Glyph="&#xE721;"
                    Header="Everything">
                    <ToggleSwitch OnContent="{loc:Tr Key=T130011756125}" OffContent="{loc:Tr Key=Tca7981b46ecf}" IsOn="{x:Bind ViewModel.ShowEverythingTab, Mode=TwoWay}" />
                    <controls:SettingsCard.Footer>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.EverythingStatus, Mode=OneWay}"
                            TextWrapping="Wrap" />
