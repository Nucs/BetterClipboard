                    Keywords="{loc:Tr Text='screenshots, print screen, PrtScn, snip, Win+Shift+S'}">
                    <ToggleSwitch OnContent="{loc:Tr Text='On'}" OffContent="{loc:Tr Text='Off'}" IsOn="{x:Bind ViewModel.ImportWindowsScreenshots, Mode=TwoWay}" />
                    <controls:SettingsCard.Footer>
