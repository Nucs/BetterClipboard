<?xml version="1.0" encoding="utf-8"?>
<!--
  The Win+V replacement: an acrylic, caption-less, always-on-top panel that opens next to the caret.
  Layout: header (title + actions) / search / filter pills / history cards / keyboard hints, plus the
  optional groups column on the left (GroupsColumn: 0 wide when closed, 44 when open — the window grows to
  the left by the same amount, so everything else stays where it was on screen and only the header's logo
  and title slide left into the column's top).
  Keyboard handling lives in Root_PreviewKeyDown so it works while focus stays in the search box.
  Root's Transparent background is load-bearing: it makes the empty areas hit-testable, so dragging the
  background moves the window like a title bar (Root_PointerPressed); a null background would let those
  presses fall through to nothing.
-->
<Window
    x:Class="BetterClipboard.App.Views.ClipboardFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:BetterClipboard.App.ViewModels"
    mc:Ignorable="d">

    <Grid
        x:Name="Root"
        Padding="12,10,12,8"
        Background="Transparent"
        PreviewKeyDown="Root_PreviewKeyDown"
        RowSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="GroupsColumn" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header (spans the groups column: its logo is the column's top icon, "the regular view")  -->
        <Grid Grid.ColumnSpan="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--  24 wide when the column is closed (the old logo spot), 36 when open (code-behind)  -->
            <Button
                x:Name="LogoButton"
                Width="24"
                Height="32"
                AutomationProperties.Name="All clipboard history"
                Click="LogoButton_Click"
                Style="{StaticResource GroupButtonStyle}"
                ToolTipService.ToolTip="All clipboard history">
                <Image
                    Width="20"
                    Height="20"
                    Source="ms-appx:///Assets/AppIcon64.png" />
            </Button>
            <!--
                A grid, not a stack: in a group view the group name takes the remaining width and trims, so the
                "Paused" chip always fits (a stack clipped it to "Pau"). GroupTitleColumn is Auto in the regular
                view (code-behind), keeping the chip right after "Clipboard". Margins instead of ColumnSpacing:
                spacing would also apply around the empty, collapsed name.
            -->
            <Grid
                x:Name="TitlePanel"
                Grid.Column="1"
                VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="GroupTitleColumn" Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Clipboard" />
                <!--  The tooltip names every group shown: merged names trim early next to the Paused chip ("Work +…").  -->
                <TextBlock
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="15"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.GroupTitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind GroupTitleTooltip(ViewModel.GroupTitle), Mode=OneWay}"
                    Visibility="{x:Bind TextVisibility(ViewModel.GroupTitle), Mode=OneWay}" />
                <Border
                    x:Name="PausedChip"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Padding="8,1,8,2"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    CornerRadius="10"
                    Visibility="{x:Bind PausedVisibility(ViewModel.IsPaused), Mode=OneWay}">
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Text="Paused" />
                </Border>
            </Grid>
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    x:Name="PauseButton"
                    AutomationProperties.Name="Pause or resume capturing"
                    Click="PauseButton_Click"
                    Content="{x:Bind PauseGlyph(ViewModel.IsPaused), Mode=OneWay}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind PauseTooltip(ViewModel.IsPaused), Mode=OneWay}" />
                <!--
                    Groups toggle. Segoe Fluent Icons has no bookmark ribbon (its "Bookmarks" E8A4 is drawn as a
                    bulleted list), so the ribbon is a 16-DIP path: an outline while the column is closed (F0 =
                    even-odd fill of an outer and an inner ribbon, 1.25 DIP apart), filled while it is open.
                    Width/Height 16 are load-bearing: they make the 16x16 design box the icon's layout box. A
                    PathIcon without them measures as its geometry's right/bottom edge (13 x 14.25 here: the path
                    is a Stretch=None shape, drawn at its own coordinates), so the button centered a box whose ink
                    sat in its lower right, and the ribbon drew 2 px right of and ~0.8 px below the button's
                    center (measured at 100 %: margins left 14 / right 10, now 12 / 12). The ribbon (x 3-13,
                    y 1.5-14.25) is centered in the 16x16 box, so centering the box centers the ribbon. Keep any
                    new geometry centered in that box.
                -->
                <Button
                    x:Name="GroupsToggle"
                    AutomationProperties.Name="Show groups"
                    Click="GroupsToggle_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Groups (Ctrl+G)">
                    <Grid>
                        <PathIcon
                            x:Name="RibbonOutline"
                            Width="16"
                            Height="16"
                            Data="F0 M4.5,1.5 H11.5 A1.5,1.5 0 0 1 13,3 V14.25 L8,10.9 L3,14.25 V3 A1.5,1.5 0 0 1 4.5,1.5 Z M4.5,2.75 A0.25,0.25 0 0 0 4.25,3 V11.9 L8,9.4 L11.75,11.9 V3 A0.25,0.25 0 0 0 11.5,2.75 Z" />
                        <PathIcon
                            x:Name="RibbonFilled"
                            Width="16"
                            Height="16"
                            Data="F1 M4.5,1.5 H11.5 A1.5,1.5 0 0 1 13,3 V14.25 L8,10.9 L3,14.25 V3 A1.5,1.5 0 0 1 4.5,1.5 Z"
                            Visibility="Collapsed" />
                    </Grid>
                </Button>
                <Button
                    x:Name="ClearButton"
                    AutomationProperties.Name="Clear history"
                    Content="&#xE74D;"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Clear history (keeps pinned and grouped items)">
                    <Button.Flyout>
                        <Flyout x:Name="ClearFlyout" Closed="Popup_Closed" Opened="Popup_Opened">
                            <StackPanel MaxWidth="260" Spacing="12">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Clear clipboard history?" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Items are deleted for good. Pinned items and items in groups stay."
                                    TextWrapping="Wrap" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Click="ConfirmClear_Click"
                                    Content="Clear"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    AutomationProperties.Name="Settings"
                    Click="SettingsButton_Click"
                    Content="&#xE713;"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Settings" />
            </StackPanel>
        </Grid>

        <!--
            Groups column: the user's group icons, "+" at the bottom. Cards dropped on an icon join that group. A click
            shows one group; Ctrl+click and Shift+click show several, merged into one list (code-behind: ClickGroup).
        -->
        <Grid
            x:Name="GroupsPane"
            Grid.Row="1"
            Grid.RowSpan="4"
            Grid.Column="0"
            Margin="0,0,8,0"
            RowSpacing="4"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Hidden"
                VerticalScrollMode="Auto">
                <StackPanel x:Name="GroupButtons" Spacing="4" />
            </ScrollViewer>
            <Button
                x:Name="AddGroupButton"
                Grid.Row="1"
                AutomationProperties.Name="New group"
                Click="AddGroupButton_Click"
                Content="&#xE710;"
                Style="{StaticResource GroupButtonStyle}"
                ToolTipService.ToolTip="New group: pick an icon, then drag cards onto it" />
        </Grid>

        <!--
            Search. The match-case / whole-word / regex toggles sit inside the box, left of the magnifier: they are the
            box's Description, which SearchBoxTextBoxStyle (App.xaml) shows in a column of its own instead of below.
            Order as in VS Code and Rider (case, word, pattern); Alt+C / Alt+W / Alt+E toggle them from the keyboard
            (Root_PreviewKeyDown), since they never take focus. Alt+E, Visual Studio's key, not VS Code's Alt+R: GPU
            overlays register Alt+R globally (NVIDIA's performance overlay, AMD's Radeon overlay), so on such PCs it
            never reaches the panel (measured 2026-10-01: RegisterHotKey(Alt+R) fails with 1409 here).
        -->
        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Row="1"
            Grid.Column="1"
            AutomationProperties.Name="Search clipboard history"
            PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
            QueryIcon="Find"
            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextBoxStyle="{StaticResource SearchBoxTextBoxStyle}">
            <AutoSuggestBox.Description>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton
                        x:Name="MatchCaseToggle"
                        AutomationProperties.AcceleratorKey="Alt+C"
                        AutomationProperties.Name="Match case"
                        Content="Aa"
                        IsChecked="{x:Bind ViewModel.MatchCase, Mode=TwoWay}"
                        Style="{StaticResource SearchOptionToggleStyle}"
                        ToolTipService.ToolTip="Match case (Alt+C)" />
                    <ToggleButton
                        x:Name="WholeWordToggle"
                        AutomationProperties.AcceleratorKey="Alt+W"
                        AutomationProperties.Name="Match whole word"
                        Content="W"
                        IsChecked="{x:Bind ViewModel.WholeWord, Mode=TwoWay}"
                        Style="{StaticResource SearchOptionToggleStyle}"
                        ToolTipService.ToolTip="Match whole word (Alt+W)" />
                    <!--  Red outline while the pattern does not parse or ran out of time (FlyoutViewModel.HasPatternError).  -->
                    <ToggleButton
                        x:Name="RegexToggle"
                        AutomationProperties.AcceleratorKey="Alt+E"
                        AutomationProperties.Name="Use regular expression"
                        Content=".*"
                        IsChecked="{x:Bind ViewModel.UseRegex, Mode=TwoWay}"
                        Style="{x:Bind RegexToggleStyle(ViewModel.HasPatternError), Mode=OneWay}"
                        ToolTipService.ToolTip="Use regular expression (Alt+E)" />
                </StackPanel>
            </AutoSuggestBox.Description>
        </AutoSuggestBox>

        <!--
            Filters: a carousel (code-behind: ClipboardFlyout.TabStrip.cs). The SelectorBar sits in a ScrollViewer that
            gives it all the width it wants, so the tabs scroll sideways when they do not fit; resizing the panel wider
            shows more of them. "<" and ">" (RepeatButtons over the strip's edges) show only while there is more to that
            side, and the strip is clipped under them (TabsScroller.Clip), so no tab label runs under an arrow. The mouse
            wheel (also the tilt wheel) and dragging the strip with the left or middle button scroll it; touch pans it
            natively. The window used to grow to fit every tab instead (MeasureTabsExtraDip, until 2026-10-01).
        -->
        <Grid
            x:Name="TabStrip"
            Grid.Row="2"
            Grid.Column="1"
            Margin="-4,0,-4,0">
            <ScrollViewer
                x:Name="TabsScroller"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                ZoomMode="Disabled">
                <SelectorBar x:Name="Filters" SelectionChanged="Filters_SelectionChanged">
                    <SelectorBar.Resources>
                        <!--
                            9 instead of WinUI's 12 px side padding: more tabs fit next to each other before the strip has
                            to scroll (seven labels need 351-366 px at 9, 393-408 at 12; measured, Segoe UI Variable 14 px).
                        -->
                        <Style TargetType="SelectorBarItem">
                            <Setter Property="Padding" Value="9,10,9,7" />
                        </Style>
                    </SelectorBar.Resources>
                    <SelectorBarItem IsSelected="True" Tag="All" Text="All" />
                    <SelectorBarItem Tag="Pinned" Text="Pinned" />
                    <SelectorBarItem Tag="Text" Text="Text" />
                    <SelectorBarItem Tag="Images" Text="Images" />
                    <SelectorBarItem Tag="Links" Text="Links" />
                    <SelectorBarItem
                        Tag="Files"
                        Text="Files"
                        ToolTipService.ToolTip="Files copied in Explorer, and copied text that is nothing but paths" />
                    <!--  Only while ShareX is installed (code-behind: UpdateShareXTab).  -->
                    <SelectorBarItem
                        x:Name="ShareXFilter"
                        Tag="ShareX"
                        Text="ShareX"
                        ToolTipService.ToolTip="Screenshots saved by ShareX and everything copied from it"
                        Visibility="Collapsed" />
                    <!--
                        Only while Settings › Snipping Tool and Win+PrtScn is on (code-behind: UpdateSnippingTab,
                        ClipboardFlyout.Snipping.cs). Its Tag is the ClipFilter name.
                    -->
                    <SelectorBarItem
                        x:Name="SnippingFilter"
                        Tag="Snipping"
                        Text="Snipping"
                        ToolTipService.ToolTip="Screenshots saved by Snipping Tool (Win+Shift+S, PrtScn) and Win+PrtScn, and everything Snipping Tool copied"
                        Visibility="Collapsed" />
                    <!--
                        Only while Settings › Win+R history is on (code-behind: UpdateRunTab). Entering it rescans Windows'
                        Win+R list first (the live watch normally has everything already).
                    -->
                    <SelectorBarItem
                        x:Name="RunFilter"
                        Tag="Run"
                        Text="Run"
                        ToolTipService.ToolTip="Commands you ran with Win+R, kept after Windows forgets them (Ctrl+Enter runs one again)"
                        Visibility="Collapsed" />
                    <!--
                        The shell tabs (code-behind: UpdateShellTabs, ClipboardFlyout.Shells.cs). Pwsh only while Settings › Pwsh tab
                        is on and PowerShell's history file exists; Cmd while Settings › Cmd tab is on. Their Tags are ClipFilter names.
                    -->
                    <SelectorBarItem
                        x:Name="PwshFilter"
                        Tag="PowerShell"
                        Text="Pwsh"
                        ToolTipService.ToolTip="Every command you typed in PowerShell, newest first, searchable (from PowerShell's own history file)"
                        Visibility="Collapsed" />
                    <SelectorBarItem
                        x:Name="CmdFilter"
                        Tag="Cmd"
                        Text="Cmd"
                        ToolTipService.ToolTip="Commands typed in Command Prompt windows, kept after the window closes"
                        Visibility="Collapsed" />
                    <!--
                        The prompt tabs (code-behind: UpdatePromptTabs, ClipboardFlyout.Prompts.cs): each while its Settings switch is
                        on and the agent's folder or the prompt archive has prompts. Entering one catches the archive up first. Their
                        Tags are ClipFilter names.
                    -->
                    <SelectorBarItem
                        x:Name="ClaudeFilter"
                        Tag="ClaudeCode"
                        Text="Claude"
                        ToolTipService.ToolTip="Every prompt you sent to Claude Code, newest first, searchable, kept after Claude Code prunes its history"
                        Visibility="Collapsed" />
                    <SelectorBarItem
                        x:Name="CodexFilter"
                        Tag="Codex"
                        Text="Codex"
                        ToolTipService.ToolTip="Every prompt you sent to Codex (the app, the CLI, the IDE extension), newest first, searchable"
                        Visibility="Collapsed" />
                    <!--  Only while voidtools Everything is installed or running and the tab is on (code-behind: UpdateEverythingTab).  -->
                    <SelectorBarItem
                        x:Name="EverythingFilter"
                        Tag="Everything"
                        Text="Everything"
                        ToolTipService.ToolTip="Files you opened in Everything, newest first, and everything copied from it"
                        Visibility="Collapsed" />
                </SelectorBar>
            </ScrollViewer>
            <!--
                The carousel's arrows: over the strip's edges, shown only while there is more to that side
                (UpdateTabArrows). RepeatButtons, like WinUI's TabView scroll buttons: each repeat reveals the next tab
                (TabStripScroll.Step), so holding one walks through the tabs. They never take focus: a click must
                leave the caret in the search box.
            -->
            <RepeatButton
                x:Name="TabsBackButton"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Scroll tabs left"
                Click="TabsBackButton_Click"
                Content="&#xE76B;"
                Style="{StaticResource TabScrollButtonStyle}"
                ToolTipService.ToolTip="Earlier tabs"
                Visibility="Collapsed" />
            <RepeatButton
                x:Name="TabsForwardButton"
                HorizontalAlignment="Right"
                AutomationProperties.Name="Scroll tabs right"
                Click="TabsForwardButton_Click"
                Content="&#xE76C;"
                Style="{StaticResource TabScrollButtonStyle}"
                ToolTipService.ToolTip="More tabs"
                Visibility="Collapsed" />
        </Grid>

        <!--  History  -->
        <!--  CanDragItems is switched on with the groups column (a drag needs a drop target).  -->
        <ListView
            x:Name="ItemsList"
            Grid.Row="3"
            Grid.Column="1"
            Margin="-4,0,-4,0"
            Padding="4,0,4,0"
            ContainerContentChanging="ItemsList_ContainerContentChanging"
            DragItemsCompleted="ItemsList_DragItemsCompleted"
            DragItemsStarting="ItemsList_DragItemsStarting"
            IsItemClickEnabled="True"
            ItemClick="ItemsList_ItemClick"
            ItemContainerStyle="{StaticResource ClipItemContainerStyle}"
            ItemsSource="{x:Bind ViewModel.Items}"
            RightTapped="ItemsList_RightTapped"
            SelectionMode="Single"
            TabIndex="1">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ClipItemViewModel">
                    <Grid AutomationProperties.Name="{x:Bind AutomationName}" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="{x:Bind KindGlyph}"
                                ToolTipService.ToolTip="{x:Bind KindLabel}" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Caption, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <!--  The icons of the groups this card is in (symbol-font text)  -->
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind GroupBadges, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind GroupBadgesTooltip, Mode=OneWay}"
                                Visibility="{x:Bind GroupBadgesVisibility, Mode=OneWay}" />
                            <FontIcon
                                Grid.Column="3"
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE842;"
                                ToolTipService.ToolTip="Pinned"
                                Visibility="{x:Bind PinVisibility, Mode=OneWay}" />
                        </Grid>

                        <TextBlock
                            Grid.Row="1"
                            FontFamily="{x:Bind BodyFontFamily}"
                            FontSize="13.5"
                            MaxLines="4"
                            Text="{x:Bind Preview}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind TextVisibility}" />

                        <Border
                            Grid.Row="1"
                            Height="128"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6"
                            Visibility="{x:Bind ImageVisibility}">
                            <Image
                                HorizontalAlignment="Center"
                                Source="{x:Bind Thumbnail, Mode=OneWay}"
                                Stretch="Uniform" />
                        </Border>

                        <StackPanel
                            Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="12"
                            Visibility="{x:Bind ColorVisibility}">
                            <Border
                                Width="32"
                                Height="32"
                                Background="{x:Bind ColorBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource MonoFontFamily}"
                                FontSize="14"
                                IsTextSelectionEnabled="False"
                                Text="{x:Bind Preview}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  Empty state  -->
        <StackPanel
            Grid.Row="3"
            Grid.Column="1"
            MaxWidth="280"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind EmptyVisibility(ViewModel.IsEmpty), Mode=OneWay}">
            <FontIcon
                FontSize="40"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE77F;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                TextAlignment="Center" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <!--  The empty Everything tab while Everything is not running (FlyoutViewModel.ShowStartEverything).  -->
            <Button
                x:Name="StartEverythingButton"
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                Click="StartEverythingButton_Click"
                Content="Start Everything"
                Visibility="{x:Bind BoolVisibility(ViewModel.ShowStartEverything), Mode=OneWay}" />
        </StackPanel>

        <!--  Footer  -->
        <Grid
            Grid.Row="4"
            Grid.Column="1"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind ViewModel.KeyHint, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Column="1"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </Grid>
    </Grid>
</Window>
